#!/usr/bin/python3
"""Fixed, independently pinned non-root archive helper for the staging PVC."""
import base64
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import time
from urllib.request import urlopen

import native_store


SCHEMA = 'voice-nats-archive-stream-v1'
CHUNK = 48 << 10
MAX_BYTES = 48 << 30
MAX_ENTRIES = 262144
MAX_TAR_BYTES = MAX_BYTES + (MAX_ENTRIES * 1024) + (1 << 20)
MAX_MANIFEST_BYTES = 512 << 20
MAX_CENSUS_BYTES = 64 << 20
READBACK_CHUNK = 48 << 10
MAX_READBACK_LINE = 96 << 10
DATA_ROOT = Path('/data')
OUT_ROOT = Path('/out')
VERIFY_ROOT = Path('/verify')
INPUT_ROOT = Path('/inputs/private')
KERNEL = Path('/voice-nats-runner/kernel')
NATS_SERVER = Path('/usr/local/bin/nats-server')
MAX_INPUT_BYTES = 4 << 20
INPUT_FILES = frozenset(('bootstrap.creds', 'social.creds', 'realtime.creds',
    'operator.jwt', 'account.jwt', 'system-account.jwt', 'account.public',
    'system-account.public', 'server.conf'))
VERIFY_PHASES = frozenset(('census',))
RECEIPT_SCHEMA = 'voice-nats-verification-v1'
CENSUS_SCHEMA = 'voice-nats-census-v1'
CENSUS_READBACK_SCHEMA = 'voice-nats-census-readback-v1'
ARCHIVE_UID = 10000
ARCHIVE_GID = 10000
VERIFICATION_UID = 65532
VERIFICATION_GID = 65532
CENSUS_INPUT_MAGIC = b'VOICE-NATS-CENSUS-INPUT-v1\0'


def _identity(args):
    if (not re.fullmatch('[a-f0-9]{12}', args.operation)
        or not re.fullmatch('[a-f0-9]{32}', args.nonce)
        or not re.fullmatch('[a-f0-9-]{36}', args.pod_uid)):
        raise ValueError('identity')


def _storage_uid(value, label):
    if not isinstance(value, str) or not re.fullmatch(r'[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}', value):
        raise ValueError(label)
    return value


def _archive_identity(args):
    return {
        'source_pvc_uid': _storage_uid(getattr(args, 'source_pvc_uid', None), 'archive_source_pvc_uid'),
        'source_pv_uid': _storage_uid(getattr(args, 'source_pv_uid', None), 'archive_source_pv_uid'),
    }


def _mode_allows(row, uid, gid, bits):
    shift = 6 if row.st_uid == uid else 3 if row.st_gid == gid else 0
    return ((row.st_mode >> shift) & bits) == bits


def _require_archive_helper_identity():
    """Keep source archive/readback RPCs in the NATS-owner helper profile."""
    if os.geteuid() != ARCHIVE_UID or os.getegid() != ARCHIVE_GID:
        raise ValueError('archive_helper_identity')


def _require_verification_identity():
    """The disposable census helper runs as its fixed non-root scratch owner."""
    if os.geteuid() != VERIFICATION_UID or os.getegid() != VERIFICATION_GID:
        raise ValueError('verification_identity')


def source_readable_by_archive_helper(root, *, uid=ARCHIVE_UID, gid=ARCHIVE_GID):
    """Check the O_NOATIME source profile without changing directory atimes."""
    root = Path(root)
    pending = [root]
    while pending:
        directory = pending.pop()
        row = directory.lstat()
        # controller.READ includes O_NOATIME; Linux permits that for the file
        # owner or CAP_FOWNER, not for a merely readable group member.
        if (not stat.S_ISDIR(row.st_mode) or row.st_uid != uid
            or not _mode_allows(row, uid, gid, 5)):
            return False
        try:
            directory_fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY
                | os.O_NOFOLLOW | os.O_NOATIME)
        except OSError:
            return False
        try:
            with os.scandir(directory_fd) as entries:
                for entry in entries:
                    child_path = directory / entry.name
                    child = entry.stat(follow_symlinks=False)
                    if stat.S_ISDIR(child.st_mode):
                        if child.st_uid != uid or not _mode_allows(child, uid, gid, 5):
                            return False
                        pending.append(child_path)
                    elif stat.S_ISREG(child.st_mode):
                        if child.st_uid != uid or not _mode_allows(child, uid, gid, 4):
                            return False
                    else:
                        return False
        finally:
            os.close(directory_fd)
    return True


def validate_verification_mounts(verification, output, inputs, *, verification_pvc_uid):
    """Check the target-only scratch boundary; the selected source is never mounted."""
    paths = [Path(verification), Path(output), Path(inputs)]
    for path in paths:
        row = path.lstat()
        if not stat.S_ISDIR(row.st_mode) or stat.S_ISLNK(row.st_mode):
            raise ValueError('verification_mounts')
    if (len({path.resolve() for path in paths}) != len(paths)
        or not re.fullmatch('[a-f0-9-]{36}', verification_pvc_uid or '')
        or not os.access(paths[0], os.W_OK)
        or not os.access(paths[1], os.W_OK)
        or not os.access(paths[2], os.W_OK)):
        raise ValueError('verification_mounts')
    return paths


def _server_config(raw):
    if not isinstance(raw, bytes) or not 1 <= len(raw) <= 256 << 10:
        raise ValueError('verification_inputs')
    try:
        text = raw.decode('utf-8', errors='strict')
    except UnicodeError:
        raise ValueError('verification_inputs') from None
    required = ('host: 127.0.0.1\n', 'port: 4222\n', 'http: 127.0.0.1:8222\n',
        'resolver: MEMORY\n')
    store_lines = ('jetstream { store_dir: /data }\n',
        'jetstream: { store_dir: /data, max_file_store: 64MB, max_memory_store: 16MB }\n')
    if any(text.count(value) != 1 for value in required) or sum(text.count(value) for value in store_lines) != 1:
        raise ValueError('verification_inputs')
    for line in store_lines:
        if line in text:
            return text.replace(line, line.replace('/data', '/verify/store', 1), 1).encode()
    raise ValueError('verification_inputs')


def _input_binding(args):
    source_uid = _storage_uid(getattr(args, 'source_pvc_uid', None), 'verification_source_pvc_uid')
    source_pv_uid = _storage_uid(getattr(args, 'source_pv_uid', None), 'verification_source_pv_uid')
    target_uid = _storage_uid(getattr(args, 'verification_pvc_uid', None), 'verification_target_pvc_uid')
    target_pv_uid = _storage_uid(getattr(args, 'verification_pv_uid', None), 'verification_target_pv_uid')
    archive_sha = getattr(args, 'archive_sha256', '')
    archive_bytes = getattr(args, 'archive_bytes', None)
    if (source_uid == target_uid or source_pv_uid == target_pv_uid
        or not re.fullmatch('[a-f0-9]{64}', archive_sha or '')
        or type(archive_bytes) is not int or not 0 < archive_bytes <= MAX_TAR_BYTES):
        raise ValueError('verification_input_binding')
    return {'purpose': 'verification', 'operation': args.operation, 'nonce': args.nonce,
        'pod_uid': args.pod_uid, 'source_pvc_uid': source_uid, 'source_pv_uid': source_pv_uid,
        'verification_pvc_uid': target_uid, 'verification_pv_uid': target_pv_uid,
        'archive_sha256': archive_sha, 'archive_bytes': archive_bytes}


def _input_action_paths(args):
    state = VERIFY_ROOT / '.voice-nats-verification'
    marker = state / (args.operation + '-' + args.nonce + '.inputs.started.json')
    receipt = state / (args.operation + '-' + args.nonce + '.inputs.receipt.json')
    return state, marker, receipt


def read_input_receipt(args):
    _require_verification_identity()
    _identity(args)
    if os.environ.get('POD_UID') != args.pod_uid:
        raise ValueError('verification_pod_identity')
    binding = _input_binding(args)
    state, marker_path, receipt_path = _input_action_paths(args)
    directory = state.lstat()
    if (not stat.S_ISDIR(directory.st_mode) or stat.S_ISLNK(directory.st_mode)
        or directory.st_uid != os.geteuid() or stat.S_IMODE(directory.st_mode) != 0o700):
        raise ValueError('verification_inputs_incomplete')
    marker = _private_json(marker_path)
    if (not isinstance(marker, dict) or marker != {'schema': 'voice-nats-input-action-v1',
        'phase': 'inputs', **binding, 'state': 'STARTED'}):
        raise ValueError('verification_input_binding')
    receipt = _private_json(receipt_path)
    if (not isinstance(receipt, dict) or receipt != {'schema': 'voice-nats-input-receipt-v1',
        'phase': 'inputs', **binding, 'status': 'COMPLETE', 'file_count': len(INPUT_FILES)}):
        raise ValueError('verification_inputs_incomplete')
    _private_inputs()
    return receipt


def load_inputs(raw=None, *, operation, nonce, pod_uid, binding_args, input_stream=None):
    """Install the closed input bundle with a PVC-persisted, no-replay receipt."""
    _require_verification_identity()
    _identity(argparse.Namespace(operation=operation, nonce=nonce, pod_uid=pod_uid))
    if os.environ.get('POD_UID') != pod_uid:
        raise ValueError('verification_pod_identity')
    binding = _input_binding(binding_args)
    if (binding['operation'] != operation or binding['nonce'] != nonce
        or binding['pod_uid'] != pod_uid):
        raise ValueError('verification_input_binding')
    state, marker_path, receipt_path = _input_action_paths(binding_args)
    if not state.exists():
        state.mkdir(mode=0o700)
    state_row = state.lstat()
    if (not stat.S_ISDIR(state_row.st_mode) or stat.S_ISLNK(state_row.st_mode)
        or state_row.st_uid != os.geteuid() or stat.S_IMODE(state_row.st_mode) != 0o700
        or any(state.iterdir())):
        raise ValueError('verification_inputs_already_started')
    marker_value = {'schema': 'voice-nats-input-action-v1', 'phase': 'inputs',
        **binding, 'state': 'STARTED'}
    fd = os.open(marker_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'wb') as marker_stream:
        marker_stream.write(json.dumps(marker_value, sort_keys=True, separators=(',', ':')).encode())
        marker_stream.flush(); os.fsync(marker_stream.fileno())
    for directory in (state, VERIFY_ROOT):
        dirfd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try: os.fsync(dirfd)
        finally: os.close(dirfd)
    if raw is None:
        if input_stream is None: input_stream = sys.stdin.buffer
        raw = input_stream.read(MAX_INPUT_BYTES + 1)
    if not isinstance(raw, (bytes, bytearray)) or not 1 <= len(raw) <= MAX_INPUT_BYTES:
        raise ValueError('verification_inputs')
    def pairs(items):
        value = {}
        for key, item in items:
            if key in value: raise ValueError('verification_inputs')
            value[key] = item
        return value
    try:
        bundle = json.loads(raw, object_pairs_hook=pairs)
    except (ValueError, TypeError, UnicodeError):
        raise ValueError('verification_inputs') from None
    if (not isinstance(bundle, dict) or set(bundle) != {'schema', 'operation', 'nonce', 'pod_uid', 'files'}
        or bundle.get('schema') != 'voice-nats-verification-inputs-v1'
        or bundle.get('operation') != operation or bundle.get('nonce') != nonce
        or bundle.get('pod_uid') != pod_uid or not isinstance(bundle.get('files'), dict)
        or set(bundle['files']) != INPUT_FILES):
        raise ValueError('verification_inputs')
    INPUT_ROOT.mkdir(mode=0o700, parents=False, exist_ok=False)
    root = INPUT_ROOT.lstat()
    if (not stat.S_ISDIR(root.st_mode) or root.st_uid != os.geteuid()
        or stat.S_IMODE(root.st_mode) & 0o077):
        raise ValueError('verification_inputs')
    decoded = {}
    for name, encoded in bundle['files'].items():
        if not isinstance(encoded, str) or len(encoded) > 512 << 10:
            raise ValueError('verification_inputs')
        try:
            import base64
            data = base64.b64decode(encoded.encode('ascii'), validate=True)
        except (ValueError, UnicodeError):
            raise ValueError('verification_inputs') from None
        if not 1 <= len(data) <= 256 << 10:
            raise ValueError('verification_inputs')
        decoded[name] = data
    _server_config(decoded['server.conf'])
    for name in sorted(INPUT_FILES):
        path = INPUT_ROOT / name
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o440)
        with os.fdopen(fd, 'wb') as stream:
            stream.write(decoded[name]); stream.flush(); os.fsync(stream.fileno())
    fd = os.open(INPUT_ROOT, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try: os.fsync(fd)
    finally: os.close(fd)
    receipt = {'schema': 'voice-nats-input-receipt-v1', 'phase': 'inputs',
        **binding, 'status': 'COMPLETE', 'file_count': len(decoded)}
    fd = os.open(receipt_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'wb') as receipt_stream:
        receipt_stream.write(json.dumps(receipt, sort_keys=True, separators=(',', ':')).encode())
        receipt_stream.flush(); os.fsync(receipt_stream.fileno())
    dirfd = os.open(state, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try: os.fsync(dirfd)
    finally: os.close(dirfd)
    return receipt


def _private_inputs():
    rows = {}
    if not INPUT_ROOT.is_dir() or INPUT_ROOT.is_symlink():
        raise ValueError('verification_inputs')
    entries = sorted(path.name for path in INPUT_ROOT.iterdir())
    if set(entries) != INPUT_FILES:
        raise ValueError('verification_inputs')
    for name in entries:
        path = INPUT_ROOT / name
        row = path.lstat()
        if (not stat.S_ISREG(row.st_mode) or row.st_uid != os.geteuid() or row.st_nlink != 1
            or stat.S_IMODE(row.st_mode) != 0o440 or row.st_size > 256 << 10):
            raise ValueError('verification_inputs')
        data = path.read_bytes()
        if len(data) != row.st_size:
            raise ValueError('verification_inputs')
        rows[name] = data
    rows['server.conf'] = _server_config(rows['server.conf'])
    return rows


def _wait_nats(process, *, deadline_seconds=120, clock=time.monotonic, sleep=time.sleep,
               get=urlopen):
    deadline = clock() + deadline_seconds
    while clock() < deadline:
        if process.poll() is not None:
            raise ValueError('verification_server_failed')
        try:
            with get('http://127.0.0.1:8222/healthz?js-enabled-only=true', timeout=1) as response:
                if response.status == 200:
                    return
        except Exception:
            pass
        sleep(0.25)
    raise ValueError('verification_server_timeout')


def _read_exact(stream, size):
    chunks = bytearray()
    while len(chunks) < size:
        part = stream.read(min(CHUNK, size - len(chunks)))
        if not part:
            raise ValueError('verification_input_truncated')
        chunks.extend(part)
    return bytes(chunks)


def _receive_archive(stream, archive_path, expected_bytes, expected_sha256):
    if _read_exact(stream, len(CENSUS_INPUT_MAGIC)) != CENSUS_INPUT_MAGIC:
        raise ValueError('verification_input_header')
    manifest_size = int.from_bytes(_read_exact(stream, 4), 'big')
    if not 1 <= manifest_size <= MAX_MANIFEST_BYTES:
        raise ValueError('verification_manifest_size')
    manifest_raw = _read_exact(stream, manifest_size)
    def unique_pairs(pairs):
        result = {}
        for key, value in pairs:
            if key in result: raise ValueError('verification_manifest')
            result[key] = value
        return result
    try:
        manifest = json.loads(manifest_raw, object_pairs_hook=unique_pairs,
            parse_constant=lambda _value: (_ for _ in ()).throw(ValueError('verification_manifest')))
        canonical = json.dumps(manifest, sort_keys=True, separators=(',', ':'),
            ensure_ascii=False, allow_nan=False).encode('utf-8')
    except (UnicodeError, TypeError, ValueError):
        raise ValueError('verification_manifest') from None
    if canonical != manifest_raw or not isinstance(manifest, dict):
        raise ValueError('verification_manifest')
    tar_size = int.from_bytes(_read_exact(stream, 8), 'big')
    if (tar_size != expected_bytes or not 0 < tar_size <= MAX_TAR_BYTES
        or manifest.get('archive_sha256') != expected_sha256):
        raise ValueError('verification_archive_binding')
    digest = hashlib.sha256()
    written = 0
    fd = os.open(archive_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        while written < tar_size:
            chunk = _read_exact(stream, min(CHUNK, tar_size - written))
            view = memoryview(chunk)
            while view:
                count = os.write(fd, view)
                if count <= 0: raise ValueError('verification_archive_write')
                view = view[count:]
            digest.update(chunk)
            written += len(chunk)
        os.fsync(fd)
    finally:
        os.close(fd)
    if stream.read(1):
        raise ValueError('verification_input_trailing_bytes')
    if written != expected_bytes or digest.hexdigest() != expected_sha256:
        raise ValueError('verification_archive_digest')
    if native_store.verify_archive(archive_path, manifest) is not True:
        raise ValueError('verification_archive')
    return manifest


def run_verification(phase_name, args, input_stream=None):
    """Accept one streamed source archive, restore the target-only scratch, and census it."""
    _require_verification_identity()
    if phase_name not in VERIFY_PHASES:
        raise ValueError('verification_phase')
    _identity(args)
    if os.environ.get('POD_UID') != args.pod_uid:
        raise ValueError('verification_pod_identity')
    source_uid = getattr(args, 'source_pvc_uid', '')
    source_pv_uid = getattr(args, 'source_pv_uid', '')
    verification_uid = getattr(args, 'verification_pvc_uid', '')
    verification_pv_uid = getattr(args, 'verification_pv_uid', '')
    archive_sha256 = getattr(args, 'archive_sha256', '')
    archive_bytes = getattr(args, 'archive_bytes', None)
    _storage_uid(source_uid, 'verification_source_pvc_uid')
    _storage_uid(source_pv_uid, 'verification_source_pv_uid')
    _storage_uid(verification_uid, 'verification_target_pvc_uid')
    _storage_uid(verification_pv_uid, 'verification_target_pv_uid')
    if (source_uid == verification_uid or source_pv_uid == verification_pv_uid
        or not re.fullmatch('[a-f0-9]{64}', archive_sha256 or '')
        or type(archive_bytes) is not int or not 0 < archive_bytes <= MAX_TAR_BYTES):
        raise ValueError('verification_binding')
    verification, output, inputs = validate_verification_mounts(VERIFY_ROOT, OUT_ROOT, INPUT_ROOT,
        verification_pvc_uid=verification_uid)
    operation_state = verification / '.voice-nats-verification'
    read_input_receipt(args)
    if (any(path != operation_state for path in verification.iterdir()) or any(output.iterdir())):
        raise ValueError('verification_already_started')
    marker = operation_state / (args.operation + '-' + args.nonce + '.census.started.json')
    marker_value = {'schema': RECEIPT_SCHEMA, 'phase': phase_name, 'purpose': 'verification',
        'operation': args.operation, 'nonce': args.nonce, 'pod_uid': args.pod_uid,
        'source_pvc_uid': source_uid, 'source_pv_uid': source_pv_uid,
        'verification_pvc_uid': verification_uid, 'verification_pv_uid': verification_pv_uid,
        'archive_sha256': archive_sha256, 'archive_bytes': archive_bytes, 'state': 'STARTED'}
    try:
        fd = os.open(marker, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    except FileExistsError:
        raise ValueError('verification_already_started') from None
    with os.fdopen(fd, 'wb') as marker_stream:
        marker_stream.write(json.dumps(marker_value, sort_keys=True, separators=(',', ':')).encode())
        marker_stream.flush(); os.fsync(marker_stream.fileno())
    for directory in (operation_state, verification):
        dirfd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try: os.fsync(dirfd)
        finally: os.close(dirfd)

    archive = output / 'verification-source.tar'
    if input_stream is None: input_stream = sys.stdin.buffer
    manifest = _receive_archive(input_stream, archive, archive_bytes, archive_sha256)
    store = verification / 'store'
    native_store.restore_closed_store(archive, store, manifest)
    rows = _private_inputs()
    config = output / 'verification-server.conf'
    fd = os.open(config, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'wb') as config_stream:
        config_stream.write(rows['server.conf']); config_stream.flush(); os.fsync(config_stream.fileno())
    config_row = config.lstat()
    if not stat.S_ISREG(config_row.st_mode) or config_row.st_size != len(rows['server.conf']):
        raise ValueError('verification_server_config')

    server = subprocess.Popen([str(NATS_SERVER), '-c', str(config)],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        close_fds=True, env={'PATH': '/usr/local/bin:/usr/bin:/bin', 'HOME': '/nonexistent'})
    try:
        _wait_nats(server)
        child = subprocess.run([str(KERNEL), '--phase', phase_name], stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, close_fds=True,
            timeout=7200, check=False, env={'PATH': '/usr/local/bin:/usr/bin:/bin', 'HOME': '/nonexistent'})
        if child.returncode != 0:
            raise ValueError('verification_kernel_failed')
    finally:
        server.terminate()
        try:
            if server.wait(timeout=30) != 0:
                raise ValueError('verification_server_stop_failed')
        except subprocess.TimeoutExpired:
            raise ValueError('verification_server_stop_timeout') from None

    result_path = output / 'census.json'
    result_stat = result_path.lstat()
    if (not stat.S_ISREG(result_stat.st_mode) or result_stat.st_size < 1
        or result_stat.st_size > MAX_CENSUS_BYTES):
        raise ValueError('verification_result')
    raw_result = result_path.read_bytes()
    if len(raw_result) != result_stat.st_size:
        raise ValueError('verification_result')
    def unique_pairs(pairs):
        result = {}
        for key, value in pairs:
            if key in result: raise ValueError('verification_result')
            result[key] = value
        return result
    try:
        result = json.loads(raw_result, object_pairs_hook=unique_pairs,
            parse_constant=lambda _value: (_ for _ in ()).throw(ValueError('verification_result')))
        if (not isinstance(result, dict) or set(result) != {'schema', 'account', 'streams', 'consumers'}
            or result.get('schema') != CENSUS_SCHEMA or not isinstance(result.get('account'), str)
            or not isinstance(result.get('streams'), list) or not isinstance(result.get('consumers'), list)):
            raise ValueError('verification_result')
        result_bytes = json.dumps(result, sort_keys=True, separators=(',', ':'),
            ensure_ascii=False, allow_nan=False).encode('utf-8')
    except (UnicodeError, TypeError, ValueError):
        raise ValueError('verification_result') from None
    if len(result_bytes) > MAX_CENSUS_BYTES:
        raise ValueError('verification_result')
    census_path = operation_state / (args.operation + '-' + args.nonce + '.census.json')
    fd = os.open(census_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'wb') as result_stream:
        result_stream.write(result_bytes); result_stream.flush(); os.fsync(result_stream.fileno())
    receipt = {'schema': RECEIPT_SCHEMA, 'phase': phase_name, 'purpose': 'verification',
        'operation': args.operation, 'nonce': args.nonce, 'pod_uid': args.pod_uid,
        'source_pvc_uid': source_uid, 'source_pv_uid': source_pv_uid,
        'verification_pvc_uid': verification_uid, 'verification_pv_uid': verification_pv_uid,
        'archive_sha256': archive_sha256, 'archive_bytes': archive_bytes,
        'census_sha256': hashlib.sha256(result_bytes).hexdigest(), 'status': 'COMPLETE'}
    receipt_path = operation_state / (args.operation + '-' + args.nonce + '.receipt.json')
    with receipt_path.open('xb') as receipt_stream:
        receipt_stream.write(json.dumps(receipt, sort_keys=True, separators=(',', ':')).encode())
        receipt_stream.flush(); os.fsync(receipt_stream.fileno())
    for directory in (operation_state, verification, output):
        dirfd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try: os.fsync(dirfd)
        finally: os.close(dirfd)
    return receipt


def read_verification_receipt(phase_name, args):
    """Read only the durable result for this exact Pod/operation; never replay it."""
    _require_verification_identity()
    if phase_name != 'census':
        raise ValueError('verification_phase')
    _identity(args)
    if os.environ.get('POD_UID') != args.pod_uid:
        raise ValueError('verification_pod_identity')
    read_input_receipt(args)
    verification = VERIFY_ROOT.lstat()
    if (not stat.S_ISDIR(verification.st_mode) or stat.S_ISLNK(verification.st_mode)
        or not os.access(VERIFY_ROOT, os.W_OK)
        or not re.fullmatch('[a-f0-9-]{36}', getattr(args, 'source_pvc_uid', '') or '')
        or not re.fullmatch('[a-f0-9-]{36}', getattr(args, 'source_pv_uid', '') or '')
        or not re.fullmatch('[a-f0-9-]{36}', getattr(args, 'verification_pvc_uid', '') or '')
        or not re.fullmatch('[a-f0-9-]{36}', getattr(args, 'verification_pv_uid', '') or '')
        or args.source_pvc_uid == args.verification_pvc_uid
        or not re.fullmatch('[a-f0-9]{64}', getattr(args, 'archive_sha256', '') or '')
        or type(getattr(args, 'archive_bytes', None)) is not int
        or not 0 < args.archive_bytes <= MAX_TAR_BYTES):
        raise ValueError('verification_mounts')
    operation_state = VERIFY_ROOT / '.voice-nats-verification'
    directory = operation_state.lstat()
    if (not stat.S_ISDIR(directory.st_mode) or stat.S_ISLNK(directory.st_mode)
        or directory.st_uid != os.geteuid() or stat.S_IMODE(directory.st_mode) != 0o700):
        raise ValueError('verification_state_invalid')
    expected_marker = {'schema', 'phase', 'purpose', 'operation', 'nonce', 'pod_uid',
        'source_pvc_uid', 'source_pv_uid', 'verification_pvc_uid', 'verification_pv_uid',
        'archive_sha256', 'archive_bytes', 'state'}
    marker = _private_json(operation_state / (args.operation + '-' + args.nonce + '.census.started.json'))
    if (not isinstance(marker, dict) or set(marker) != expected_marker
        or marker != {'schema': RECEIPT_SCHEMA, 'phase': phase_name, 'purpose': 'verification',
            'operation': args.operation, 'nonce': args.nonce, 'pod_uid': args.pod_uid,
            'source_pvc_uid': args.source_pvc_uid, 'source_pv_uid': args.source_pv_uid,
            'verification_pvc_uid': args.verification_pvc_uid,
            'verification_pv_uid': args.verification_pv_uid,
            'archive_sha256': args.archive_sha256, 'archive_bytes': args.archive_bytes,
            'state': 'STARTED'}):
        raise ValueError('verification_receipt_binding')
    receipt_path = operation_state / (args.operation + '-' + args.nonce + '.receipt.json')
    try:
        row = receipt_path.lstat()
    except FileNotFoundError:
        raise ValueError('verification_receipt_incomplete') from None
    if (not stat.S_ISREG(row.st_mode) or row.st_uid != os.geteuid()
        or stat.S_IMODE(row.st_mode) != 0o600 or row.st_nlink != 1
        or not 1 <= row.st_size <= 16384):
        raise ValueError('verification_receipt_incomplete')
    receipt = _private_json(receipt_path)
    if (not isinstance(receipt, dict) or set(receipt) != {
            'schema', 'phase', 'purpose', 'operation', 'nonce', 'pod_uid', 'source_pvc_uid',
            'source_pv_uid', 'verification_pvc_uid', 'verification_pv_uid',
            'archive_sha256', 'archive_bytes', 'census_sha256', 'status'}
        or receipt.get('schema') != RECEIPT_SCHEMA or receipt.get('phase') != phase_name
        or receipt.get('purpose') != 'verification'
        or receipt.get('operation') != args.operation or receipt.get('nonce') != args.nonce
        or receipt.get('pod_uid') != args.pod_uid
        or receipt.get('source_pvc_uid') != args.source_pvc_uid
        or receipt.get('source_pv_uid') != args.source_pv_uid
        or receipt.get('verification_pvc_uid') != args.verification_pvc_uid
        or receipt.get('verification_pv_uid') != args.verification_pv_uid
        or receipt.get('archive_sha256') != args.archive_sha256
        or receipt.get('archive_bytes') != args.archive_bytes
        or not re.fullmatch('[a-f0-9]{64}', receipt.get('archive_sha256', ''))
        or not re.fullmatch('[a-f0-9]{64}', receipt.get('census_sha256', ''))
        or receipt.get('status') != 'COMPLETE'):
        raise ValueError('verification_receipt_binding')
    census_path = operation_state / (args.operation + '-' + args.nonce + '.census.json')
    try:
        census_stat = census_path.lstat()
    except FileNotFoundError:
        raise ValueError('verification_receipt_incomplete') from None
    if (not stat.S_ISREG(census_stat.st_mode) or census_stat.st_uid != os.geteuid()
        or stat.S_IMODE(census_stat.st_mode) != 0o600 or census_stat.st_nlink != 1
        or not 1 <= census_stat.st_size <= MAX_CENSUS_BYTES):
        raise ValueError('verification_receipt_incomplete')
    census_raw = census_path.read_bytes()
    if len(census_raw) != census_stat.st_size or hashlib.sha256(census_raw).hexdigest() != receipt['census_sha256']:
        raise ValueError('verification_receipt_binding')
    try:
        census = json.loads(census_raw)
    except (UnicodeError, ValueError):
        raise ValueError('verification_receipt_binding') from None
    if (not isinstance(census, dict) or set(census) != {'schema', 'account', 'streams', 'consumers'}
        or census.get('schema') != CENSUS_SCHEMA or not isinstance(census.get('account'), str)
        or not isinstance(census.get('streams'), list) or not isinstance(census.get('consumers'), list)
        or json.dumps(census, sort_keys=True, separators=(',', ':'), ensure_ascii=False,
            allow_nan=False).encode('utf-8') != census_raw):
        raise ValueError('verification_receipt_binding')
    return {'receipt': receipt, 'census': census}


def bind_only(args):
    """Open a read-only mount of one newly created WFFC target, then exit.

    Kubernetes attachment and typed API readback establish claim/PV identity;
    this fixed process only causes scheduling and proves the target mount exists.
    It has no source volume, fsGroup, file writes, or caller-provided path.
    """
    if (args.role not in ('verification', 'restore')
        or os.geteuid() != 65532 or os.getegid() != 65532):
        raise ValueError('bind_profile')
    _identity(args)
    if os.environ.get('POD_UID') != args.pod_uid:
        raise ValueError('bind_pod_identity')
    row = VERIFY_ROOT.lstat()
    if not stat.S_ISDIR(row.st_mode) or stat.S_ISLNK(row.st_mode):
        raise ValueError('bind_target_mount')
    return {'schema': 'voice-nats-bind-mount-v1', 'operation': args.operation,
        'nonce': args.nonce, 'pod_uid': args.pod_uid, 'role': args.role,
        'mounted': True}


def _frame(row):
    encoded = json.dumps(row, sort_keys=True, separators=(',', ':'), allow_nan=False).encode('utf-8')
    if len(encoded) + 1 > MAX_READBACK_LINE:
        raise ValueError('readback_frame_size')
    sys.stdout.buffer.write(encoded + b'\n')
    sys.stdout.buffer.flush()


def stream_census_readback(result):
    """Emit the full bounded census as fixed-size records over pods/exec stdout."""
    receipt, census = result['receipt'], result['census']
    raw = json.dumps(census, sort_keys=True, separators=(',', ':'), allow_nan=False).encode('utf-8')
    if (not raw or len(raw) > MAX_CENSUS_BYTES
        or hashlib.sha256(raw).hexdigest() != receipt.get('census_sha256')):
        raise ValueError('verification_receipt_binding')
    identity = {key: receipt[key] for key in
        ('operation', 'nonce', 'pod_uid', 'source_pvc_uid', 'source_pv_uid',
         'verification_pvc_uid', 'verification_pv_uid', 'purpose',
         'archive_sha256', 'archive_bytes')}
    count = 0
    for sequence, offset in enumerate(range(0, len(raw), READBACK_CHUNK)):
        chunk = raw[offset:offset + READBACK_CHUNK]
        _frame({'schema': CENSUS_READBACK_SCHEMA, **identity, 'kind': 'data',
            'sequence': sequence, 'data': base64.b64encode(chunk).decode('ascii')})
        count += 1
    _frame({'schema': CENSUS_READBACK_SCHEMA, **identity, 'kind': 'complete',
        'frames': count, 'byte_count': len(raw), 'census_sha256': receipt['census_sha256'],
        'receipt': receipt})


def _stream(archive, manifest, args):
    _identity(args)
    identity = _archive_identity(args)
    fd = os.open(archive, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    digest = hashlib.sha256()
    size = 0
    sequence = 0
    with os.fdopen(fd, 'rb') as source:
        before = os.fstat(fd)
        if not 0 < before.st_size <= MAX_TAR_BYTES:
            raise ValueError('archive-size')
        while True:
            data = source.read(CHUNK)
            if not data:
                break
            size += len(data)
            if size > MAX_TAR_BYTES:
                raise ValueError('archive-size')
            digest.update(data)
            _frame({'schema': SCHEMA, 'operation': args.operation, 'nonce': args.nonce,
                **identity,
                'pod_uid': args.pod_uid, 'kind': 'data', 'sequence': sequence,
                'data': base64.b64encode(data).decode('ascii')})
            sequence += 1
        after = os.fstat(fd)
        if (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns, before.st_ctime_ns) != (
            after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns, after.st_ctime_ns):
            raise ValueError('archive-changed')
    if digest.hexdigest() != manifest['archive_sha256']:
        raise ValueError('archive-digest')
    manifest_raw = json.dumps(manifest, sort_keys=True, separators=(',', ':')).encode()
    if len(manifest_raw) > MAX_MANIFEST_BYTES:
        raise ValueError('manifest-size')
    manifest_digest = hashlib.sha256(manifest_raw).hexdigest()
    manifest_frames = 0
    for offset in range(0, len(manifest_raw), CHUNK):
        _frame({'schema': SCHEMA, 'operation': args.operation, 'nonce': args.nonce,
            **identity,
            'pod_uid': args.pod_uid, 'kind': 'manifest', 'sequence': manifest_frames,
            'data': base64.b64encode(manifest_raw[offset:offset+CHUNK]).decode('ascii')})
        manifest_frames += 1
    _frame({'schema': SCHEMA, 'operation': args.operation, 'nonce': args.nonce,
        **identity,
        'pod_uid': args.pod_uid, 'kind': 'complete', 'frames': sequence,
        'manifest_frames': manifest_frames, 'archive_sha256': digest.hexdigest(),
        'manifest_sha256': manifest_digest})


def _manifest_path():
    return OUT_ROOT / 'archive.manifest.json'


def create_and_stream(args):
    _require_archive_helper_identity()
    _identity(args)
    identity = _archive_identity(args)
    target = OUT_ROOT / 'archive.tar'
    marker = _manifest_path()
    partial = OUT_ROOT / 'archive.partial.tar'
    if target.exists() or marker.exists() or partial.exists():
        # A previous invocation may have reached durable output before the
        # caller lost its stream. Only explicit recovery may read it back.
        raise ValueError('archive_already_started')
    if not source_readable_by_archive_helper(DATA_ROOT):
        raise ValueError('archive_source_permissions')
    manifest = native_store.archive_closed_store(DATA_ROOT, partial)
    if not native_store.verify_archive(partial, manifest):
        raise ValueError('archive-verification')
    os.link(partial, target, follow_symlinks=False)
    partial.unlink()
    manifest_bytes = json.dumps(manifest, sort_keys=True, separators=(',', ':')).encode()
    record = {'schema': SCHEMA, 'operation': args.operation, 'nonce': args.nonce,
        'pod_uid': args.pod_uid, **identity, 'archive_sha256': manifest['archive_sha256'],
        'manifest': manifest}
    pending = marker.with_suffix('.pending')
    fd = os.open(pending, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'wb') as output:
        output.write(json.dumps(record, sort_keys=True, separators=(',', ':')).encode())
        output.flush()
        os.fsync(output.fileno())
    os.link(pending, marker, follow_symlinks=False)
    pending.unlink()
    directory = os.open(OUT_ROOT, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try: os.fsync(directory)
    finally: os.close(directory)
    _stream(target, manifest, args)


def stream_existing(args):
    _require_archive_helper_identity()
    _identity(args)
    identity = _archive_identity(args)
    target = OUT_ROOT / 'archive.tar'
    record = _private_json(_manifest_path())
    if (set(record) != {'schema', 'operation', 'nonce', 'pod_uid', 'source_pvc_uid', 'source_pv_uid',
            'archive_sha256', 'manifest'}
        or record.get('schema') != SCHEMA or record.get('operation') != args.operation
        or record.get('nonce') != args.nonce or record.get('pod_uid') != args.pod_uid
        or record.get('source_pvc_uid') != identity['source_pvc_uid']
        or record.get('source_pv_uid') != identity['source_pv_uid']
        or record.get('archive_sha256') != record.get('manifest', {}).get('archive_sha256')
        or native_store.verify_archive(target, record['manifest']) is not True):
        raise ValueError('archive-readback-binding')
    _stream(target, record['manifest'], args)


def _private_json(path):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        before = os.fstat(fd)
        if (not stat.S_ISREG(before.st_mode) or before.st_uid != os.geteuid()
            or before.st_nlink != 1 or before.st_mode & 0o077
            or not 1 <= before.st_size <= MAX_MANIFEST_BYTES):
            raise ValueError('manifest-custody')
        raw = bytearray()
        while len(raw) <= before.st_size:
            part = os.read(fd, min(1 << 20, before.st_size + 1 - len(raw)))
            if not part: break
            raw.extend(part)
        after = os.fstat(fd)
        if (len(raw) != before.st_size or (before.st_dev, before.st_ino, before.st_size,
            before.st_mtime_ns, before.st_ctime_ns) != (after.st_dev, after.st_ino,
            after.st_size, after.st_mtime_ns, after.st_ctime_ns)):
            raise ValueError('manifest-changed')
        return json.loads(raw)
    finally:
        os.close(fd)


def serve(args):
    _require_archive_helper_identity()
    _identity(args)
    _archive_identity(args)
    while True:
        time.sleep(60)


def serve_census(args):
    _require_verification_identity()
    _identity(args)
    if os.environ.get('POD_UID') != args.pod_uid:
        raise ValueError('verification_pod_identity')
    while True:
        time.sleep(60)


def main(argv=None):
    parser = argparse.ArgumentParser(add_help=False)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument('--serve', action='store_true')
    mode.add_argument('--create-and-stream', action='store_true')
    mode.add_argument('--stream-existing', action='store_true')
    mode.add_argument('--load-inputs', action='store_true')
    mode.add_argument('--read-input-receipt', action='store_true')
    mode.add_argument('--read-receipt', action='store_true')
    mode.add_argument('--bind-only', action='store_true')
    mode.add_argument('--serve-census', action='store_true')
    mode.add_argument('--receive-archive', action='store_true')
    mode.add_argument('--phase', choices=sorted(VERIFY_PHASES))
    parser.add_argument('--operation', required=True)
    parser.add_argument('--nonce', required=True)
    parser.add_argument('--pod-uid', required=False)
    parser.add_argument('--source-pvc-uid')
    parser.add_argument('--source-pv-uid')
    parser.add_argument('--verification-pvc-uid')
    parser.add_argument('--verification-pv-uid')
    parser.add_argument('--archive-sha256')
    parser.add_argument('--archive-bytes', type=int)
    parser.add_argument('--role', choices=('verification', 'restore'))
    args = parser.parse_args(argv)
    if args.serve:
        if args.pod_uid is not None: parser.error('serve-shape')
        try: _archive_identity(args)
        except ValueError: parser.error('serve-storage-identity-required')
        args.pod_uid = os.environ.get('POD_UID', '')
        serve(args)
    if args.serve_census:
        if (args.pod_uid is not None or args.phase is not None or args.source_pvc_uid is not None
            or args.source_pv_uid is not None or args.verification_pvc_uid is not None
            or args.verification_pv_uid is not None or args.archive_sha256 is not None
            or args.archive_bytes is not None):
            parser.error('serve-census-shape')
        args.pod_uid = os.environ.get('POD_UID', '')
        serve_census(args)
    if args.bind_only:
        if (args.role is None or args.phase is not None or args.source_pvc_uid is not None
            or args.verification_pvc_uid is not None or args.pod_uid is not None):
            parser.error('bind-only-shape')
        args.pod_uid = os.environ.get('POD_UID', '')
        return bind_only(args)
    if args.pod_uid is None: parser.error('pod-uid-required')
    if args.load_inputs:
        if (args.phase is not None or not args.source_pvc_uid or not args.source_pv_uid
            or not args.verification_pvc_uid or not args.verification_pv_uid
            or not args.archive_sha256 or args.archive_bytes is None):
            parser.error('load-inputs-shape')
        result = load_inputs(None, operation=args.operation, nonce=args.nonce,
            pod_uid=args.pod_uid, binding_args=args, input_stream=sys.stdin.buffer)
        _frame(result)
        return result
    if args.read_input_receipt:
        if (args.phase is not None or not args.source_pvc_uid or not args.source_pv_uid
            or not args.verification_pvc_uid or not args.verification_pv_uid
            or not args.archive_sha256 or args.archive_bytes is None):
            parser.error('read-input-receipt-shape')
        result = read_input_receipt(args)
        _frame(result)
        return result
    if args.read_receipt:
        if (args.phase is None or not args.source_pvc_uid or not args.source_pv_uid
            or not args.verification_pvc_uid or not args.verification_pv_uid
            or not args.archive_sha256 or args.archive_bytes is None):
            parser.error('verification-volume-identity-required')
        receipt = read_verification_receipt(args.phase, args)
        stream_census_readback(receipt)
        return receipt
    if args.receive_archive:
        if (not args.source_pvc_uid or not args.source_pv_uid
            or not args.verification_pvc_uid or not args.verification_pv_uid
            or not args.archive_sha256 or args.archive_bytes is None or args.phase is not None):
            parser.error('verification-volume-identity-required')
        receipt = run_verification('census', args)
        return receipt
    (create_and_stream if args.create_and_stream else stream_existing)(args)


if __name__ == '__main__':
    try:
        main()
    except Exception:
        # Kubernetes logs and exec status never receive archive data or paths.
        sys.stderr.write('nats_phase_failed\n')
        raise SystemExit(1)
