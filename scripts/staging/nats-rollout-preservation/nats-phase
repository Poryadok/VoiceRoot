def _wait_nats(process, *, deadline_seconds=120, clock=time.monotonic, sleep=time.sleep,
               get=urlopen):
    deadline = clock() + deadline_seconds
    while clock() < deadline:
        if process.poll() is not None:
            raise ValueError('verification_server_failed')
        try:
            with get('http://127.0.0.1:8222/healthz?js-enabled-only=true', timeout=1) as response:
                if response.status == 200:
                    return
        except Exception:
            pass
        sleep(0.25)
    raise ValueError('verification_server_timeout')


def _read_exact(stream, size):
    chunks = bytearray()
    while len(chunks) < size:
        part = stream.read(min(CHUNK, size - len(chunks)))
        if not part:
            raise ValueError('verification_input_truncated')
        chunks.extend(part)
    return bytes(chunks)


def _receive_archive(stream, archive_path, expected_bytes, expected_sha256, *, magic=CENSUS_INPUT_MAGIC):
    if _read_exact(stream, len(magic)) != magic:
        raise ValueError('verification_input_header')
    manifest_size = int.from_bytes(_read_exact(stream, 4), 'big')
    if not 1 <= manifest_size <= MAX_MANIFEST_BYTES:
        raise ValueError('verification_manifest_size')
    manifest_raw = _read_exact(stream, manifest_size)
    def unique_pairs(pairs):
        result = {}
        for key, value in pairs:
            if key in result: raise ValueError('verification_manifest')
            result[key] = value
        return result
    try:
        manifest = json.loads(manifest_raw, object_pairs_hook=unique_pairs,
            parse_constant=lambda _value: (_ for _ in ()).throw(ValueError('verification_manifest')))
        canonical = json.dumps(manifest, sort_keys=True, separators=(',', ':'),
            ensure_ascii=False, allow_nan=False).encode('utf-8')
    except (UnicodeError, TypeError, ValueError):
        raise ValueError('verification_manifest') from None
    if canonical != manifest_raw or not isinstance(manifest, dict):
        raise ValueError('verification_manifest')
    tar_size = int.from_bytes(_read_exact(stream, 8), 'big')
    if (tar_size != expected_bytes or not 0 < tar_size <= MAX_TAR_BYTES
        or manifest.get('archive_sha256') != expected_sha256):
        raise ValueError('verification_archive_binding')
    digest = hashlib.sha256()
    written = 0
    fd = os.open(archive_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        while written < tar_size:
            chunk = _read_exact(stream, min(CHUNK, tar_size - written))
            view = memoryview(chunk)
            while view:
                count = os.write(fd, view)
                if count <= 0: raise ValueError('verification_archive_write')
                view = view[count:]
            digest.update(chunk)
            written += len(chunk)
        os.fsync(fd)
    finally:
        os.close(fd)
    if stream.read(1):
        raise ValueError('verification_input_trailing_bytes')
    if written != expected_bytes or digest.hexdigest() != expected_sha256:
        raise ValueError('verification_archive_digest')
    if native_store.verify_archive(archive_path, manifest) is not True:
        raise ValueError('verification_archive')
    return manifest


def run_verification(phase_name, args, input_stream=None):
    """Accept one streamed source archive, restore the target-only scratch, and census it."""
    _require_verification_identity()
    if phase_name not in VERIFY_PHASES:
        raise ValueError('verification_phase')
    _identity(args)
    if os.environ.get('POD_UID') != args.pod_uid:
        raise ValueError('verification_pod_identity')
    source_uid = getattr(args, 'source_pvc_uid', '')
    source_pv_uid = getattr(args, 'source_pv_uid', '')
    verification_uid = getattr(args, 'verification_pvc_uid', '')
    verification_pv_uid = getattr(args, 'verification_pv_uid', '')
    archive_sha256 = getattr(args, 'archive_sha256', '')
    archive_bytes = getattr(args, 'archive_bytes', None)
    _storage_uid(source_uid, 'verification_source_pvc_uid')
    _storage_uid(source_pv_uid, 'verification_source_pv_uid')
    _storage_uid(verification_uid, 'verification_target_pvc_uid')
    _storage_uid(verification_pv_uid, 'verification_target_pv_uid')
    if (source_uid == verification_uid or source_pv_uid == verification_pv_uid
        or not re.fullmatch('[a-f0-9]{64}', archive_sha256 or '')
        or type(archive_bytes) is not int or not 0 < archive_bytes <= MAX_TAR_BYTES):
        raise ValueError('verification_binding')
    verification, output, inputs = validate_verification_mounts(VERIFY_ROOT, OUT_ROOT, INPUT_ROOT,
        verification_pvc_uid=verification_uid)
    operation_state = verification / '.voice-nats-verification'
    read_census_consumption_receipt(args)
    allowed_verification = {operation_state, verification / 'state',
        verification / 'kernelinputbundle', verification / 'inputs'}
    if (any(path not in allowed_verification for path in verification.iterdir()) or any(output.iterdir())):
        raise ValueError('verification_already_started')
    if not operation_state.exists():
        operation_state.mkdir(mode=0o700)
    state_row = operation_state.lstat()
    if (not stat.S_ISDIR(state_row.st_mode) or stat.S_ISLNK(state_row.st_mode)
        or state_row.st_uid != os.geteuid() or stat.S_IMODE(state_row.st_mode) != 0o700):
        raise ValueError('verification_state_invalid')
    marker = operation_state / (args.operation + '-' + args.nonce + '.census.started.json')
    marker_value = {'schema': RECEIPT_SCHEMA, 'phase': phase_name, 'purpose': 'verification',
        'operation': args.operation, 'nonce': args.nonce, 'pod_uid': args.pod_uid,
        'source_pvc_uid': source_uid, 'source_pv_uid': source_pv_uid,
        'verification_pvc_uid': verification_uid, 'verification_pv_uid': verification_pv_uid,
        'archive_sha256': archive_sha256, 'archive_bytes': archive_bytes, 'state': 'STARTED'}
    try:
        fd = os.open(marker, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    except FileExistsError:
        raise ValueError('verification_already_started') from None
    with os.fdopen(fd, 'wb') as marker_stream:
        marker_stream.write(json.dumps(marker_value, sort_keys=True, separators=(',', ':')).encode())
        marker_stream.flush(); os.fsync(marker_stream.fileno())
    for directory in (operation_state, verification):
        dirfd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try: os.fsync(dirfd)
        finally: os.close(dirfd)

    archive = output / 'verification-source.tar'
    if input_stream is None: input_stream = sys.stdin.buffer
    manifest = _receive_archive(input_stream, archive, archive_bytes, archive_sha256)
    store = verification / 'store'
    native_store.restore_closed_store(archive, store, manifest)
    rows = _private_census_inputs()
    config = output / 'verification-server.conf'
    fd = os.open(config, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'wb') as config_stream:
        config_stream.write(rows['server.conf']); config_stream.flush(); os.fsync(config_stream.fileno())
    config_row = config.lstat()
    if not stat.S_ISREG(config_row.st_mode) or config_row.st_size != len(rows['server.conf']):
        raise ValueError('verification_server_config')

    server = subprocess.Popen([str(NATS_SERVER), '-c', str(config)],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        close_fds=True, env={'PATH': '/usr/local/bin:/usr/bin:/bin', 'HOME': '/nonexistent'})
    try:
        _wait_nats(server)
        child = subprocess.run([str(KERNEL), '--phase', phase_name], stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, close_fds=True,
            timeout=7200, check=False, env={'PATH': '/usr/local/bin:/usr/bin:/bin', 'HOME': '/nonexistent'})
        if child.returncode != 0:
            raise ValueError('verification_kernel_failed')
    finally:
        server.terminate()
        try:
            if server.wait(timeout=30) != 0:
                raise ValueError('verification_server_stop_failed')
        except subprocess.TimeoutExpired:
            raise ValueError('verification_server_stop_timeout') from None

    result_path = output / 'census.json'
    result_stat = result_path.lstat()
    if (not stat.S_ISREG(result_stat.st_mode) or result_stat.st_size < 1
        or result_stat.st_size > MAX_CENSUS_BYTES):
        raise ValueError('verification_result')
    raw_result = result_path.read_bytes()
    if len(raw_result) != result_stat.st_size:
        raise ValueError('verification_result')
    def unique_pairs(pairs):
        result = {}
        for key, value in pairs:
            if key in result: raise ValueError('verification_result')
            result[key] = value
        return result
    try:
        result = json.loads(raw_result, object_pairs_hook=unique_pairs,
            parse_constant=lambda _value: (_ for _ in ()).throw(ValueError('verification_result')))
        if (not isinstance(result, dict) or set(result) != {'schema', 'account', 'streams', 'consumers'}
            or result.get('schema') != CENSUS_SCHEMA or not isinstance(result.get('account'), str)
            or not isinstance(result.get('streams'), list) or not isinstance(result.get('consumers'), list)):
            raise ValueError('verification_result')
        result_bytes = json.dumps(result, sort_keys=True, separators=(',', ':'),
            ensure_ascii=False, allow_nan=False).encode('utf-8')
    except (UnicodeError, TypeError, ValueError):
        raise ValueError('verification_result') from None
    if len(result_bytes) > MAX_CENSUS_BYTES:
        raise ValueError('verification_result')
    census_path = operation_state / (args.operation + '-' + args.nonce + '.census.json')
    fd = os.open(census_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'wb') as result_stream:
        result_stream.write(result_bytes); result_stream.flush(); os.fsync(result_stream.fileno())
    receipt = {'schema': RECEIPT_SCHEMA, 'phase': phase_name, 'purpose': 'verification',
        'operation': args.operation, 'nonce': args.nonce, 'pod_uid': args.pod_uid,
        'source_pvc_uid': source_uid, 'source_pv_uid': source_pv_uid,
        'verification_pvc_uid': verification_uid, 'verification_pv_uid': verification_pv_uid,
        'archive_sha256': archive_sha256, 'archive_bytes': archive_bytes,
        'census_sha256': hashlib.sha256(result_bytes).hexdigest(), 'status': 'COMPLETE'}
    receipt_path = operation_state / (args.operation + '-' + args.nonce + '.receipt.json')
    with receipt_path.open('xb') as receipt_stream:
        receipt_stream.write(json.dumps(receipt, sort_keys=True, separators=(',', ':')).encode())
        receipt_stream.flush(); os.fsync(receipt_stream.fileno())
    for directory in (operation_state, verification, output):
        dirfd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try: os.fsync(dirfd)
        finally: os.close(dirfd)
    return receipt


def read_verification_receipt(phase_name, args):
    """Read only the durable result for this exact Pod/operation; never replay it."""
    _require_verification_identity()
    if phase_name != 'census':
        raise ValueError('verification_phase')
    _identity(args)
    if os.environ.get('POD_UID') != args.pod_uid:
        raise ValueError('verification_pod_identity')
    read_census_consumption_receipt(args)
    verification = VERIFY_ROOT.lstat()
    if (not stat.S_ISDIR(verification.st_mode) or stat.S_ISLNK(verification.st_mode)
        or not os.access(VERIFY_ROOT, os.W_OK)
        or not re.fullmatch('[a-f0-9-]{36}', getattr(args, 'source_pvc_uid', '') or '')
        or not re.fullmatch('[a-f0-9-]{36}', getattr(args, 'source_pv_uid', '') or '')
        or not re.fullmatch('[a-f0-9-]{36}', getattr(args, 'verification_pvc_uid', '') or '')
        or not re.fullmatch('[a-f0-9-]{36}', getattr(args, 'verification_pv_uid', '') or '')
        or args.source_pvc_uid == args.verification_pvc_uid
        or not re.fullmatch('[a-f0-9]{64}', getattr(args, 'archive_sha256', '') or '')
        or type(getattr(args, 'archive_bytes', None)) is not int
        or not 0 < args.archive_bytes <= MAX_TAR_BYTES):
        raise ValueError('verification_mounts')
    operation_state = VERIFY_ROOT / '.voice-nats-verification'
    directory = operation_state.lstat()
    if (not stat.S_ISDIR(directory.st_mode) or stat.S_ISLNK(directory.st_mode)
        or directory.st_uid != os.geteuid() or stat.S_IMODE(directory.st_mode) != 0o700):
        raise ValueError('verification_state_invalid')
    expected_marker = {'schema', 'phase', 'purpose', 'operation', 'nonce', 'pod_uid',
        'source_pvc_uid', 'source_pv_uid', 'verification_pvc_uid', 'verification_pv_uid',
        'archive_sha256', 'archive_bytes', 'state'}
    marker = _private_json(operation_state / (args.operation + '-' + args.nonce + '.census.started.json'))
    if (not isinstance(marker, dict) or set(marker) != expected_marker
        or marker != {'schema': RECEIPT_SCHEMA, 'phase': phase_name, 'purpose': 'verification',
            'operation': args.operation, 'nonce': args.nonce, 'pod_uid': args.pod_uid,
            'source_pvc_uid': args.source_pvc_uid, 'source_pv_uid': args.source_pv_uid,
            'verification_pvc_uid': args.verification_pvc_uid,
            'verification_pv_uid': args.verification_pv_uid,
            'archive_sha256': args.archive_sha256, 'archive_bytes': args.archive_bytes,
            'state': 'STARTED'}):
        raise ValueError('verification_receipt_binding')
    receipt_path = operation_state / (args.operation + '-' + args.nonce + '.receipt.json')
    try:
        row = receipt_path.lstat()
    except FileNotFoundError:
        raise ValueError('verification_receipt_incomplete') from None
    if (not stat.S_ISREG(row.st_mode) or row.st_uid != os.geteuid()
        or stat.S_IMODE(row.st_mode) != 0o600 or row.st_nlink != 1
        or not 1 <= row.st_size <= 16384):
        raise ValueError('verification_receipt_incomplete')
    receipt = _private_json(receipt_path)
    if (not isinstance(receipt, dict) or set(receipt) != {
            'schema', 'phase', 'purpose', 'operation', 'nonce', 'pod_uid', 'source_pvc_uid',
            'source_pv_uid', 'verification_pvc_uid', 'verification_pv_uid',
            'archive_sha256', 'archive_bytes', 'census_sha256', 'status'}
        or receipt.get('schema') != RECEIPT_SCHEMA or receipt.get('phase') != phase_name
        or receipt.get('purpose') != 'verification'
        or receipt.get('operation') != args.operation or receipt.get('nonce') != args.nonce
        or receipt.get('pod_uid') != args.pod_uid
        or receipt.get('source_pvc_uid') != args.source_pvc_uid
        or receipt.get('source_pv_uid') != args.source_pv_uid
        or receipt.get('verification_pvc_uid') != args.verification_pvc_uid
        or receipt.get('verification_pv_uid') != args.verification_pv_uid
        or receipt.get('archive_sha256') != args.archive_sha256
        or receipt.get('archive_bytes') != args.archive_bytes
        or not re.fullmatch('[a-f0-9]{64}', receipt.get('archive_sha256', ''))
        or not re.fullmatch('[a-f0-9]{64}', receipt.get('census_sha256', ''))
        or receipt.get('status') != 'COMPLETE'):
        raise ValueError('verification_receipt_binding')
    census_path = operation_state / (args.operation + '-' + args.nonce + '.census.json')
    try:
        census_stat = census_path.lstat()
    except FileNotFoundError:
        raise ValueError('verification_receipt_incomplete') from None
    if (not stat.S_ISREG(census_stat.st_mode) or census_stat.st_uid != os.geteuid()
        or stat.S_IMODE(census_stat.st_mode) != 0o600 or census_stat.st_nlink != 1
        or not 1 <= census_stat.st_size <= MAX_CENSUS_BYTES):
        raise ValueError('verification_receipt_incomplete')
    census_raw = census_path.read_bytes()
    if len(census_raw) != census_stat.st_size or hashlib.sha256(census_raw).hexdigest() != receipt['census_sha256']:
        raise ValueError('verification_receipt_binding')
    try:
        census = json.loads(census_raw)
    except (UnicodeError, ValueError):
        raise ValueError('verification_receipt_binding') from None
    if (not isinstance(census, dict) or set(census) != {'schema', 'account', 'streams', 'consumers'}
        or census.get('schema') != CENSUS_SCHEMA or not isinstance(census.get('account'), str)
        or not isinstance(census.get('streams'), list) or not isinstance(census.get('consumers'), list)
        or json.dumps(census, sort_keys=True, separators=(',', ':'), ensure_ascii=False,
            allow_nan=False).encode('utf-8') != census_raw):
        raise ValueError('verification_receipt_binding')
    return {'receipt': receipt, 'census': census}


def bind_only(args):
    """Open a read-only mount of one newly created WFFC target, then exit.

    Kubernetes attachment and typed API readback establish claim/PV identity;
    this fixed process only causes scheduling and proves the target mount exists.
    It has no source volume, fsGroup, file writes, or caller-provided path.
    """
    if (args.role != 'verification'
        or os.geteuid() != 65532 or os.getegid() != 65532):
        raise ValueError('bind_profile')
    _identity(args)
    if os.environ.get('POD_UID') != args.pod_uid:
        raise ValueError('bind_pod_identity')
    row = VERIFY_ROOT.lstat()
    if not stat.S_ISDIR(row.st_mode) or stat.S_ISLNK(row.st_mode):
        raise ValueError('bind_target_mount')
    return {'schema': 'voice-nats-bind-mount-v1', 'operation': args.operation,
        'nonce': args.nonce, 'pod_uid': args.pod_uid, 'role': args.role,
        'mounted': True}


def _frame(row):
    encoded = json.dumps(row, sort_keys=True, separators=(',', ':'), allow_nan=False).encode('utf-8')
    if len(encoded) + 1 > MAX_READBACK_LINE:
        raise ValueError('readback_frame_size')
    sys.stdout.buffer.write(encoded + b'\n')
    sys.stdout.buffer.flush()


def stream_census_readback(result):
    """Emit the full bounded census as fixed-size records over pods/exec stdout."""
    receipt, census = result['receipt'], result['census']
    raw = json.dumps(census, sort_keys=True, separators=(',', ':'), allow_nan=False).encode('utf-8')
    if (not raw or len(raw) > MAX_CENSUS_BYTES
        or hashlib.sha256(raw).hexdigest() != receipt.get('census_sha256')):
        raise ValueError('verification_receipt_binding')
    identity = {key: receipt[key] for key in
        ('operation', 'nonce', 'pod_uid', 'source_pvc_uid', 'source_pv_uid',
         'verification_pvc_uid', 'verification_pv_uid', 'purpose',
         'archive_sha256', 'archive_bytes')}
    count = 0
    for sequence, offset in enumerate(range(0, len(raw), READBACK_CHUNK)):
        chunk = raw[offset:offset + READBACK_CHUNK]
        _frame({'schema': CENSUS_READBACK_SCHEMA, **identity, 'kind': 'data',
            'sequence': sequence, 'data': base64.b64encode(chunk).decode('ascii')})
        count += 1
    _frame({'schema': CENSUS_READBACK_SCHEMA, **identity, 'kind': 'complete',
        'frames': count, 'byte_count': len(raw), 'census_sha256': receipt['census_sha256'],
        'receipt': receipt})


def _stream(archive, manifest, args):
    _identity(args)
    identity = _archive_identity(args)
    fd = os.open(archive, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    digest = hashlib.sha256()
    size = 0
    sequence = 0
    with os.fdopen(fd, 'rb') as source:
        before = os.fstat(fd)
        if not 0 < before.st_size <= MAX_TAR_BYTES:
            raise ValueError('archive-size')
        while True:
            data = source.read(CHUNK)
            if not data:
                break
            size += len(data)
            if size > MAX_TAR_BYTES:
                raise ValueError('archive-size')
            digest.update(data)
            _frame({'schema': SCHEMA, 'operation': args.operation, 'nonce': args.nonce,
                **identity,
                'pod_uid': args.pod_uid, 'kind': 'data', 'sequence': sequence,
                'data': base64.b64encode(data).decode('ascii')})
            sequence += 1
        after = os.fstat(fd)
        if (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns, before.st_ctime_ns) != (
            after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns, after.st_ctime_ns):
            raise ValueError('archive-changed')
    if digest.hexdigest() != manifest['archive_sha256']:
        raise ValueError('archive-digest')
    manifest_raw = json.dumps(manifest, sort_keys=True, separators=(',', ':')).encode()
    if len(manifest_raw) > MAX_MANIFEST_BYTES:
        raise ValueError('manifest-size')
    manifest_digest = hashlib.sha256(manifest_raw).hexdigest()
    manifest_frames = 0
    for offset in range(0, len(manifest_raw), CHUNK):
        _frame({'schema': SCHEMA, 'operation': args.operation, 'nonce': args.nonce,
            **identity,
            'pod_uid': args.pod_uid, 'kind': 'manifest', 'sequence': manifest_frames,
            'data': base64.b64encode(manifest_raw[offset:offset+CHUNK]).decode('ascii')})
        manifest_frames += 1
    _frame({'schema': SCHEMA, 'operation': args.operation, 'nonce': args.nonce,
        **identity,
        'pod_uid': args.pod_uid, 'kind': 'complete', 'frames': sequence,
        'manifest_frames': manifest_frames, 'archive_sha256': digest.hexdigest(),
        'manifest_sha256': manifest_digest})


def _manifest_path():
    return OUT_ROOT / 'archive.manifest.json'


def create_and_stream(args):
    _require_archive_helper_identity()
    _identity(args)
    identity = _archive_identity(args)
    target = OUT_ROOT / 'archive.tar'
    marker = _manifest_path()
    partial = OUT_ROOT / 'archive.partial.tar'
    if target.exists() or marker.exists() or partial.exists():
        # A previous invocation may have reached durable output before the
        # caller lost its stream. Only explicit recovery may read it back.
        raise ValueError('archive_already_started')
    if not source_readable_by_archive_helper(DATA_ROOT):
        raise ValueError('archive_source_permissions')
    manifest = native_store.archive_closed_store(DATA_ROOT, partial)
    if not native_store.verify_archive(partial, manifest):
        raise ValueError('archive-verification')
    os.link(partial, target, follow_symlinks=False)
    partial.unlink()
    manifest_bytes = json.dumps(manifest, sort_keys=True, separators=(',', ':')).encode()
    record = {'schema': SCHEMA, 'operation': args.operation, 'nonce': args.nonce,
        'pod_uid': args.pod_uid, **identity, 'archive_sha256': manifest['archive_sha256'],
        'manifest': manifest}
    pending = marker.with_suffix('.pending')
    fd = os.open(pending, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'wb') as output:
        output.write(json.dumps(record, sort_keys=True, separators=(',', ':')).encode())
        output.flush()
        os.fsync(output.fileno())
    os.link(pending, marker, follow_symlinks=False)
    pending.unlink()
    directory = os.open(OUT_ROOT, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try: os.fsync(directory)
    finally: os.close(directory)
    _stream(target, manifest, args)


def stream_existing(args):
    _require_archive_helper_identity()
    _identity(args)
    identity = _archive_identity(args)
    target = OUT_ROOT / 'archive.tar'
    record = _private_json(_manifest_path())
    if (set(record) != {'schema', 'operation', 'nonce', 'pod_uid', 'source_pvc_uid', 'source_pv_uid',
            'archive_sha256', 'manifest'}
        or record.get('schema') != SCHEMA or record.get('operation') != args.operation
        or record.get('nonce') != args.nonce or record.get('pod_uid') != args.pod_uid
        or record.get('source_pvc_uid') != identity['source_pvc_uid']
        or record.get('source_pv_uid') != identity['source_pv_uid']
        or record.get('archive_sha256') != record.get('manifest', {}).get('archive_sha256')
        or native_store.verify_archive(target, record['manifest']) is not True):
        raise ValueError('archive-readback-binding')
    _stream(target, record['manifest'], args)


def _private_json(path):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        before = os.fstat(fd)
        if (not stat.S_ISREG(before.st_mode) or before.st_uid != os.geteuid()
            or before.st_nlink != 1 or before.st_mode & 0o077
            or not 1 <= before.st_size <= MAX_MANIFEST_BYTES):
            raise ValueError('manifest-custody')
        raw = bytearray()
        while len(raw) <= before.st_size:
            part = os.read(fd, min(1 << 20, before.st_size + 1 - len(raw)))
            if not part: break
            raw.extend(part)
        after = os.fstat(fd)
        if (len(raw) != before.st_size or (before.st_dev, before.st_ino, before.st_size,
            before.st_mtime_ns, before.st_ctime_ns) != (after.st_dev, after.st_ino,
            after.st_size, after.st_mtime_ns, after.st_ctime_ns)):
            raise ValueError('manifest-changed')
        return json.loads(raw)
    finally:
        os.close(fd)


def _session_binding(args):
    _identity(args)
    if os.environ.get('POD_UID') != args.pod_uid:
        raise ValueError('session_pod_identity')
    if not re.fullmatch('[a-f0-9]{8}', args.session_attempt or ''):
        raise ValueError('session_attempt')
    input_pod_uid = getattr(args, 'input_pod_uid', '')
    input_sha = getattr(args, 'input_bundle_sha256', '')
    input_bytes = getattr(args, 'input_bundle_bytes', None)
    archive_sha = getattr(args, 'archive_sha256', '')
    archive_bytes = getattr(args, 'archive_bytes', None)
    kernel_sha = getattr(args, 'kernel_bundle_sha256', '')
    server_sha = getattr(args, 'server_config_sha256', '')
    if (not re.fullmatch('[a-f0-9-]{36}', input_pod_uid or '')
        or not re.fullmatch('[a-f0-9]{64}', input_sha or '')
        or type(input_bytes) is not int or not 0 < input_bytes <= MAX_INPUT_BYTES
        or not re.fullmatch('[a-f0-9]{64}', archive_sha or '')
        or type(archive_bytes) is not int or not 0 < archive_bytes <= MAX_TAR_BYTES
        or not re.fullmatch('[a-f0-9]{64}', kernel_sha or '')
        or not re.fullmatch('[a-f0-9]{64}', server_sha or '')):
        raise ValueError('session_input_binding')
    return {
        'schema': 'voice-nats-session-action-v1',
        'operation': args.operation,
        'nonce': args.nonce,
        'pod_uid': args.pod_uid,
        'input_pod_uid': input_pod_uid,
        'session_attempt': args.session_attempt,
        'input_bundle_sha256': input_sha,
        'input_bundle_bytes': input_bytes,
        'archive_sha256': archive_sha,
        'archive_bytes': archive_bytes,
        'kernel_bundle_sha256': kernel_sha,
        'server_config_sha256': server_sha,
        'source_pvc_uid': _storage_uid(args.source_pvc_uid, 'session_source_pvc_uid'),
        'source_pv_uid': _storage_uid(args.source_pv_uid, 'session_source_pv_uid'),
        'verification_pvc_uid': _storage_uid(args.verification_pvc_uid, 'session_verification_pvc_uid'),
        'verification_pv_uid': _storage_uid(args.verification_pv_uid, 'session_verification_pv_uid'),
    }


def _session_consume_inputs(binding, root):
    """Validate the prior loader Pod's durable bundle and journal this Pod's adoption."""
    root = _session_state_root(root)
    started_path = root / 'input-consumption.started.json'
    receipt_path = root / 'input-consumption.receipt.json'
    intent = {'schema': 'voice-nats-session-input-consumption-v1', 'state': 'STARTED',
        **{key: binding[key] for key in ('operation', 'nonce', 'pod_uid', 'input_pod_uid',
            'session_attempt', 'input_bundle_sha256', 'input_bundle_bytes', 'archive_sha256',
            'archive_bytes', 'source_pvc_uid', 'source_pv_uid', 'verification_pvc_uid',
            'verification_pv_uid')}}
    if started_path.exists() or receipt_path.exists():
        raise ValueError('session_input_consumption_unknown')
    _write_exclusive(started_path, json.dumps(intent, sort_keys=True,
        separators=(',', ':'), allow_nan=False).encode())
    input_root = SESSION_INPUT_ROOT
    row = input_root.lstat()
    if (not stat.S_ISDIR(row.st_mode) or stat.S_ISLNK(row.st_mode)
        or row.st_uid != SESSION_UID or row.st_gid != SESSION_GID
        or stat.S_IMODE(row.st_mode) != 0o700
        or set(path.name for path in input_root.iterdir()) != SESSION_INPUT_FILES):
        raise ValueError('session_inputs')
    digests = {}
    for name in sorted(SESSION_INPUT_FILES):
        raw = _read_session_file(input_root / name, max_bytes=256 << 10,
            uid=SESSION_UID, gid=SESSION_GID, mode=0o440, code='session_inputs')
        digests[name] = hashlib.sha256(raw).hexdigest()
    bundle_sha = hashlib.sha256(json.dumps(digests, sort_keys=True,
        separators=(',', ':')).encode()).hexdigest()
    if bundle_sha != binding['kernel_bundle_sha256']:
        raise ValueError('session_inputs_digest')
    loader_started = root / 'inputs.started.json'
    loader_receipt = root / 'inputs.receipt.json'
    started = _read_session_file(loader_started, max_bytes=SESSION_MAX_MESSAGE,
        uid=SESSION_UID, gid=SESSION_GID, mode=0o600, code='session_inputs_incomplete')
    receipt_raw = _read_session_file(loader_receipt, max_bytes=SESSION_MAX_MESSAGE,
        uid=SESSION_UID, gid=SESSION_GID, mode=0o600, code='session_inputs_incomplete')
    try:
        started_value = json.loads(started)
        receipt = json.loads(receipt_raw)
    except (UnicodeError, ValueError):
        raise ValueError('session_inputs_incomplete') from None
    input_binding = {'purpose': 'verification', 'operation': binding['operation'],
        'nonce': binding['nonce'], 'pod_uid': binding['input_pod_uid'],
        'source_pvc_uid': binding['source_pvc_uid'], 'source_pv_uid': binding['source_pv_uid'],
        'verification_pvc_uid': binding['verification_pvc_uid'],
        'verification_pv_uid': binding['verification_pv_uid'],
        'archive_sha256': binding['archive_sha256'], 'archive_bytes': binding['archive_bytes'],
        'session_attempt': binding['session_attempt'],
        'input_bundle_sha256': binding['input_bundle_sha256'],
        'input_bundle_bytes': binding['input_bundle_bytes']}
    expected_started = {'schema': 'voice-nats-input-action-v1', 'phase': 'inputs',
        **input_binding, 'state': 'STARTED'}
    expected_receipt = {'schema': 'voice-nats-input-receipt-v1', 'phase': 'inputs',
        **input_binding, 'status': 'COMPLETE', 'file_count': len(INPUT_FILES),
        'kernel_bundle_sha256': binding['kernel_bundle_sha256'],
        'server_config_sha256': binding['server_config_sha256']}
    if (started_value != expected_started or not isinstance(receipt, dict)
        or set(receipt) != set(expected_receipt)
        or any(receipt.get(key) != value for key, value in expected_receipt.items())
        or receipt.get('kernel_bundle_sha256') != bundle_sha):
        raise ValueError('session_inputs_incomplete')
    complete = {'schema': intent['schema'], 'state': 'COMPLETE',
        **{key: intent[key] for key in intent if key not in ('schema', 'state')},
        'kernel_bundle_sha256': bundle_sha,
        'server_config_sha256': receipt['server_config_sha256']}
    _write_exclusive(receipt_path, json.dumps(complete, sort_keys=True,
        separators=(',', ':'), allow_nan=False).encode())
    return complete


def _session_state_root(root=SESSION_ROOT):
    root = Path(root)
    row = root.lstat()
    if (not stat.S_ISDIR(row.st_mode) or stat.S_ISLNK(row.st_mode)
        or row.st_uid != SESSION_UID or row.st_gid != SESSION_GID
        or stat.S_IMODE(row.st_mode) != 0o700):
        raise ValueError('session_state_custody')
    return root


def _write_exclusive(path, raw, mode=0o600):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
    try:
        view = memoryview(raw)
        while view:
            count = os.write(fd, view)
            if count <= 0:
                raise ValueError('session_state_write')
            view = view[count:]
        os.fsync(fd)
    finally:
        os.close(fd)
    parent_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(parent_fd)
    finally:
        os.close(parent_fd)


def _session_action_paths(root, action):
    if action not in SESSION_ACTIONS:
        raise ValueError('session_action_invalid')
    slug = action.replace('-', '_')
    return root / (slug + '.started.json'), root / (slug + '.receipt.json'), root / (slug + '.output')


def _session_inputs():
    root = SESSION_INPUT_ROOT
    row = root.lstat()
    if not stat.S_ISDIR(row.st_mode) or stat.S_ISLNK(row.st_mode):
        raise ValueError('session_inputs')
    entries = sorted(path.name for path in root.iterdir())
    expected = sorted(SESSION_INPUT_FILES)
    if entries != expected:
        raise ValueError('session_inputs')
    data = {}
    for name in expected:
        path = root / name
        data[name] = _read_session_file(path, max_bytes=256 << 10,
            uid=SESSION_UID, gid=SESSION_GID, mode=0o440, code='session_inputs')
    return data


def _read_session_file(path, *, max_bytes, uid=None, gid=None,
        mode=0o600, code='session_state_file'):
    """Read one fixed private file without following links or accepting swaps."""
    if uid is None:
        uid = SESSION_UID
    if gid is None:
        gid = SESSION_GID
    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
    if hasattr(os, 'O_CLOEXEC'):
        flags |= os.O_CLOEXEC
    fd = os.open(path, flags)
    try:
        before = os.fstat(fd)
        if (not stat.S_ISREG(before.st_mode) or before.st_uid != uid or before.st_gid != gid
            or before.st_nlink != 1 or stat.S_IMODE(before.st_mode) != mode
            or not 0 < before.st_size <= max_bytes):
            raise ValueError(code)
        chunks = []
        remaining = before.st_size
        while remaining:
            chunk = os.read(fd, min(1 << 20, remaining))
            if not chunk:
                raise ValueError(code)
            chunks.append(chunk)
            remaining -= len(chunk)
        if os.read(fd, 1):
            raise ValueError(code)
        after = os.fstat(fd)
        if ((before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns, before.st_ctime_ns)
            != (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns, after.st_ctime_ns)):
            raise ValueError(code)
        return b''.join(chunks)
    finally:
        os.close(fd)


def _perform_session_action(action, root):
    if action in SESSION_KERNEL_PHASES:
        _session_inputs()
        phase = SESSION_KERNEL_PHASES[action]
        command = [str(KERNEL), '--phase', phase]
        if phase in ('verify-closed', 'drain', 'verify-drained'):
            command.append('--session-state')
        result = subprocess.run(command, stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=1800, check=False)
        if result.returncode != 0:
            raise ValueError('session_kernel_failed')
        name = 'census.json' if phase == 'census' else 'fixture.json' if phase == 'seed' else None
        if name is None:
            return None
        source = OUT_ROOT / name
        raw = _read_session_file(source, max_bytes=SESSION_MAX_OUTPUT,
            uid=SESSION_UID, gid=SESSION_GID, mode=0o600, code='session_kernel_output')
        target = root / (action.replace('-', '_') + '.output')
        _write_exclusive(target, raw)
        return {'output_name': target.name, 'output_sha256': hashlib.sha256(raw).hexdigest(),
            'output_bytes': len(raw)}
    script = SESSION_BOOTSTRAP_SCRIPTS.get(action)
    if script is not None:
        _session_inputs()
        env = {'PATH': '/usr/local/bin:/usr/bin:/bin', 'HOME': '/tmp',
            'NATS_URL': 'nats://127.0.0.1:4222',
            'NATS_CREDS': '/inputs/bootstrap.creds'}
        result = subprocess.run(['/bin/sh', script], stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=env,
            timeout=1800, check=False)
        if result.returncode != 0:
            raise ValueError('session_bootstrap_failed')
        return None
    if action in ('broker-ready', 'broker-restart-prepare', 'broker-restart-complete',
        'session-close', 'session-stop'):
        command = {'broker-ready': 'start', 'broker-restart-prepare': 'stop',
            'broker-restart-complete': 'start', 'session-close': 'stop',
            'session-stop': 'shutdown'}[action]
        _supervisor_call(command)
        return None
    raise ValueError('session_action_invalid')


def _supervisor_call(action, *, connector=socket.create_connection):
    if action not in ('start', 'stop', 'status', 'shutdown'):
        raise ValueError('supervisor_action_invalid')
    request = {'schema': 'voice-nats-supervisor-v1', 'action': action}
    raw = json.dumps(request, sort_keys=True, separators=(',', ':')).encode() + b'\n'
    if len(raw) > 256:
        raise ValueError('supervisor_request')
    with connector(('127.0.0.1', SUPERVISOR_PORT), timeout=10) as client:
        client.sendall(raw)
        response = bytearray()
        while len(response) <= 256:
            part = client.recv(1)
            if not part or part == b'\n':
                break
            response.extend(part)
        if not part or len(response) > 256:
            raise ValueError('supervisor_response')
    try:
        value = json.loads(response)
    except (UnicodeError, ValueError):
        raise ValueError('supervisor_response') from None
    fields = {'schema', 'ok', 'running'} | ({'stopping'} if action == 'shutdown' else set())
    expected_running = action == 'start'
    if (not isinstance(value, dict) or set(value) != fields
        or value.get('schema') != 'voice-nats-supervisor-v1' or value.get('ok') is not True
        or value.get('running') is not expected_running
        or (action == 'shutdown' and value.get('stopping') is not True)):
        raise ValueError('supervisor_action_failed')
    return value


def _session_receipt(action, binding, root, *, perform):
    started_path, receipt_path, output_path = _session_action_paths(root, action)
    started = {'schema': binding['schema'], 'state': 'STARTED', 'action': action,
        **{key: binding[key] for key in binding if key != 'schema'}}
    if receipt_path.exists():
        receipt, output = _session_readback(action, binding, root)
        if output is not None:
            output.close()
        return receipt
    if started_path.exists():
        existing = json.loads(_read_session_file(started_path, max_bytes=SESSION_MAX_MESSAGE,
            uid=SESSION_UID, gid=SESSION_GID, mode=0o600, code='session_started_custody'))
        if existing != started:
            raise ValueError('session_started_identity')
        raise ValueError('session_action_unknown')
    _write_exclusive(started_path, json.dumps(started, sort_keys=True,
        separators=(',', ':'), allow_nan=False).encode())
    details = perform(action, root)
    receipt = {'schema': binding['schema'], 'state': 'COMPLETE', 'action': action,
        **{key: binding[key] for key in binding if key != 'schema'}}
    if details:
        receipt.update(details)
    _write_exclusive(receipt_path, json.dumps(receipt, sort_keys=True,
        separators=(',', ':'), allow_nan=False).encode())
    return receipt


def _session_readback(action, binding, root):
    _session_state_root(root)
    started_path, receipt_path, output_path = _session_action_paths(root, action)
    if not started_path.exists() or not receipt_path.exists():
        raise ValueError('session_receipt_missing')
    started = json.loads(_read_session_file(started_path, max_bytes=SESSION_MAX_MESSAGE,
        uid=SESSION_UID, gid=SESSION_GID, mode=0o600, code='session_started_custody'))
    receipt = json.loads(_read_session_file(receipt_path, max_bytes=SESSION_MAX_MESSAGE,
        uid=SESSION_UID, gid=SESSION_GID, mode=0o600, code='session_receipt_custody'))
    identity = {key: binding[key] for key in binding if key != 'schema'}
    expected_started = {'schema': binding['schema'], 'state': 'STARTED', 'action': action, **identity}
    expected_receipt = {'schema': binding['schema'], 'state': 'COMPLETE', 'action': action, **identity}
    output_fields = {'output_name', 'output_bytes', 'output_sha256'}
    if (started != expected_started or not isinstance(receipt, dict)
        or not set(receipt) in (set(expected_receipt), set(expected_receipt) | output_fields)
        or any(receipt.get(key) != value for key, value in expected_receipt.items())):
        raise ValueError('session_receipt_identity')
    output_values = {key: receipt.get(key) for key in output_fields}
    if any(value is not None for value in output_values.values()):
        if set(receipt) != set(expected_receipt) | output_fields:
            raise ValueError('session_receipt_output')
        output = output_values['output_name']
        if (output != output_path.name or type(output_values['output_bytes']) is not int
            or not isinstance(output_values['output_sha256'], str)
            or not re.fullmatch('[a-f0-9]{64}', output_values['output_sha256'])):
            raise ValueError('session_receipt_output')
        fd = os.open(root / output, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        before = os.fstat(fd)
        if (not stat.S_ISREG(before.st_mode) or before.st_uid != SESSION_UID
            or before.st_gid != SESSION_GID or before.st_nlink != 1
            or stat.S_IMODE(before.st_mode) != 0o600
            or before.st_size != output_values['output_bytes']
            or before.st_size > SESSION_MAX_OUTPUT):
            os.close(fd)
            raise ValueError('session_receipt_output')
        digest = hashlib.sha256()
        read_size = 0
        while True:
            part = os.read(fd, 1 << 20)
            if not part:
                break
            digest.update(part)
            read_size += len(part)
        after = os.fstat(fd)
        if (read_size != before.st_size or (before.st_dev, before.st_ino, before.st_size,
            before.st_mtime_ns, before.st_ctime_ns) != (after.st_dev, after.st_ino,
            after.st_size, after.st_mtime_ns, after.st_ctime_ns)
            or digest.hexdigest() != output_values['output_sha256']):
            os.close(fd)
            raise ValueError('session_receipt_output')
        os.lseek(fd, 0, os.SEEK_SET)
        output_stream = os.fdopen(fd, 'rb')
    else:
        if output_path.exists():
            raise ValueError('session_receipt_output')
        output_stream = None
    return receipt, output_stream


def _session_rpc(args, *, readback):
    action = getattr(args, 'action', None)
    if action not in SESSION_ACTIONS:
        raise ValueError('session_action_invalid')
    binding = _session_binding(args)
    request = {'schema': 'voice-nats-session-rpc-v1', 'action': action,
        'readback': bool(readback), 'binding': binding}
    raw = json.dumps(request, sort_keys=True, separators=(',', ':'), allow_nan=False).encode() + b'\n'
    if len(raw) > SESSION_MAX_MESSAGE:
        raise ValueError('session_rpc_size')
    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        client.settimeout(30)
        client.connect(str(SESSION_SOCKET))
        client.sendall(raw)
        response = bytearray()
        while len(response) <= SESSION_MAX_MESSAGE:
            part = client.recv(1)
            if not part or part == b'\n':
                break
            response.extend(part)
        if len(response) > SESSION_MAX_MESSAGE or not part:
            raise ValueError('session_rpc_response')
        result = json.loads(response)
        if not isinstance(result, dict) or result.get('ok') is not True or not isinstance(result.get('receipt'), dict):
            raise ValueError('session_rpc_failed')
        receipt = result['receipt']
        if not readback:
            if client.recv(1):
                raise ValueError('session_rpc_response')
            _frame(receipt)
            return receipt
        expected = receipt.get('output_bytes', 0)
        if type(expected) is not int or not 0 <= expected <= SESSION_MAX_OUTPUT:
            raise ValueError('session_rpc_response')
        with tempfile.TemporaryFile(dir=OUT_ROOT) as payload:
            digest = hashlib.sha256()
            remaining = expected
            while remaining:
                part = client.recv(min(SESSION_FRAME, remaining))
                if not part:
                    raise ValueError('session_rpc_output')
                payload.write(part)
                digest.update(part)
                remaining -= len(part)
            if client.recv(1):
                raise ValueError('session_rpc_output')
            if digest.hexdigest() != receipt.get('output_sha256', hashlib.sha256(b'').hexdigest()):
                raise ValueError('session_rpc_output')
            payload.seek(0)
            stream_session_readback(receipt, payload, expected)
        return receipt
    finally:
        client.close()


def stream_session_readback(receipt, stream, size):
    common = {key: receipt[key] for key in ('operation', 'nonce', 'pod_uid', 'session_attempt',
        'source_pvc_uid', 'source_pv_uid', 'verification_pvc_uid', 'verification_pv_uid', 'action')}
    frames = 0
    offset = 0
    while offset < size:
        chunk = stream.read(min(SESSION_FRAME, size - offset))
        if not chunk:
            raise ValueError('session_readback_output')
        record = {'schema': 'voice-nats-session-readback-v1', 'kind': 'data', **common,
            'sequence': frames, 'data': base64.b64encode(chunk).decode('ascii')}
        line = json.dumps(record, sort_keys=True, separators=(',', ':')).encode() + b'\n'
        if len(line) > SESSION_FRAME_LINE:
            raise ValueError('session_readback_frame')
        sys.stdout.buffer.write(line)
        frames += 1
        offset += len(chunk)
    complete = {'schema': 'voice-nats-session-readback-v1', 'kind': 'complete', **common,
        'status': 'COMPLETE', 'frames': frames, 'byte_count': size,
        'output_sha256': receipt.get('output_sha256', hashlib.sha256(b'').hexdigest()),
        'receipt': receipt}
    line = json.dumps(complete, sort_keys=True, separators=(',', ':')).encode() + b'\n'
    if len(line) > SESSION_FRAME_LINE:
        raise ValueError('session_readback_frame')
    sys.stdout.buffer.write(line)
    sys.stdout.buffer.flush()


def _serve_session(args):
    _require_verification_identity()
    binding = _session_binding(args)
    root = _session_state_root()
    _session_consume_inputs(binding, root)
    if SESSION_SOCKET.exists() or SESSION_SOCKET.is_symlink():
        raise ValueError('session_socket_exists')
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        server.bind(str(SESSION_SOCKET))
        os.chmod(SESSION_SOCKET, 0o600)
        server.listen(4)
        server.settimeout(1.0)
        closing = False
        while not closing:
            try:
                conn, _ = server.accept()
            except socket.timeout:
                continue
            with conn:
                conn.settimeout(30)
                if hasattr(socket, 'SO_PEERCRED'):
                    import struct
                    credentials = conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize('3i'))
                    _pid, uid, gid = struct.unpack('3i', credentials)
                    if uid != SESSION_UID or gid != SESSION_GID:
                        raise ValueError('session_peer_identity')
                data = bytearray()
                while len(data) <= SESSION_MAX_MESSAGE and b'\n' not in data:
                    part = conn.recv(4096)
                    if not part:
                        break
                    data.extend(part)
                line, sep, trailing = bytes(data).partition(b'\n')
                if not sep or trailing or len(line) > SESSION_MAX_MESSAGE:
                    raise ValueError('session_rpc_request')
                request = json.loads(line)
                if (not isinstance(request, dict) or set(request) != {'schema', 'action', 'readback', 'binding'}
                    or request.get('schema') != 'voice-nats-session-rpc-v1'
                    or request.get('binding') != binding or type(request.get('readback')) is not bool
                    or request.get('action') not in SESSION_ACTIONS):
                    raise ValueError('session_rpc_request')
                action = request['action']
                if request['readback']:
                    receipt, output = _session_readback(action, binding, root)
                else:
                    if action == 'session-stop':
                        _session_readback('session-close', binding, root)
                    receipt = _session_receipt(action, binding, root,
                        perform=_perform_session_action)
                response = {'ok': True, 'receipt': receipt}
                encoded = json.dumps(response, sort_keys=True, separators=(',', ':'), allow_nan=False).encode() + b'\n'
                if len(encoded) > SESSION_MAX_MESSAGE:
                    raise ValueError('session_rpc_response')
                conn.sendall(encoded)
                if request['readback'] and output is not None:
                    try:
                        while True:
                            chunk = output.read(SESSION_FRAME)
                            if not chunk:
                                break
                            conn.sendall(chunk)
                    finally:
                        output.close()
                closing = action == 'session-stop' and not request['readback']
    finally:
        server.close()
        try:
            SESSION_SOCKET.unlink()
        except FileNotFoundError:
            pass


def serve(args):
    _require_archive_helper_identity()
    _identity(args)
    _archive_identity(args)
    while True:
        time.sleep(60)


def serve_census(args):
    _require_verification_identity()
    _identity(args)
    if os.environ.get('POD_UID') != args.pod_uid:
        raise ValueError('verification_pod_identity')
    while True:
        time.sleep(60)


def main(argv=None):
    parser = argparse.ArgumentParser(add_help=False)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument('--serve', action='store_true')
    mode.add_argument('--create-and-stream', action='store_true')
    mode.add_argument('--stream-existing', action='store_true')
    mode.add_argument('--load-inputs', action='store_true')
    mode.add_argument('--read-input-receipt', action='store_true')
    mode.add_argument('--load-census-inputs', action='store_true')
    mode.add_argument('--read-census-input-receipt', action='store_true')
    mode.add_argument('--consume-census-inputs', action='store_true')
    mode.add_argument('--read-receipt', action='store_true')
    mode.add_argument('--bind-only', action='store_true')
    mode.add_argument('--serve-census', action='store_true')
    mode.add_argument('--receive-archive', action='store_true')
    mode.add_argument('--serve-selected-session', action='store_true')
    mode.add_argument('--session-action', action='store_true')
    mode.add_argument('--session-readback', action='store_true')
    mode.add_argument('--phase', choices=sorted(VERIFY_PHASES))
    parser.add_argument('--operation', required=True)
    parser.add_argument('--nonce', required=True)
    parser.add_argument('--pod-uid', required=False)
    parser.add_argument('--source-pvc-uid')
    parser.add_argument('--source-pv-uid')
    parser.add_argument('--verification-pvc-uid')
    parser.add_argument('--verification-pv-uid')
    parser.add_argument('--session-attempt')
    parser.add_argument('--input-pod-uid')
    parser.add_argument('--input-bundle-sha256')
    parser.add_argument('--input-bundle-bytes', type=int)
    parser.add_argument('--kernel-bundle-sha256')
    parser.add_argument('--server-config-sha256')
    parser.add_argument('--action', choices=sorted(SESSION_ACTIONS))
    parser.add_argument('--archive-sha256')
    parser.add_argument('--archive-bytes', type=int)
    parser.add_argument('--role', choices=('verification',))
    args = parser.parse_args(argv)
    if args.serve:
        if args.pod_uid is not None: parser.error('serve-shape')
        try: _archive_identity(args)
        except ValueError: parser.error('serve-storage-identity-required')
        args.pod_uid = os.environ.get('POD_UID', '')
        serve(args)
    if args.serve_census:
        if (args.pod_uid is not None or args.phase is not None or args.source_pvc_uid is not None
            or args.source_pv_uid is not None or args.verification_pvc_uid is not None
            or args.verification_pv_uid is not None or args.archive_sha256 is not None
            or args.archive_bytes is not None):
            parser.error('serve-census-shape')
        args.pod_uid = os.environ.get('POD_UID', '')
        serve_census(args)
    if args.serve_selected_session:
        if (args.pod_uid is not None or args.phase is not None
            or args.role is not None or args.action is not None
            or args.input_pod_uid is None or args.input_bundle_sha256 is None
            or args.input_bundle_bytes is None or args.kernel_bundle_sha256 is None
            or args.server_config_sha256 is None or args.archive_sha256 is None
            or args.archive_bytes is None):
            parser.error('serve-selected-session-shape')
        args.pod_uid = os.environ.get('POD_UID', '')
        _serve_session(args)
        return
    if args.bind_only:
        if (args.role is None or args.phase is not None or args.source_pvc_uid is not None
            or args.verification_pvc_uid is not None or args.pod_uid is not None):
            parser.error('bind-only-shape')
        args.pod_uid = os.environ.get('POD_UID', '')
        return bind_only(args)
    if args.pod_uid is None: parser.error('pod-uid-required')
    if args.session_action or args.session_readback:
        if (args.action is None or args.phase is not None
            or args.role is not None or args.input_pod_uid is None
            or args.input_bundle_sha256 is None or args.input_bundle_bytes is None
            or args.kernel_bundle_sha256 is None or args.server_config_sha256 is None
            or args.archive_sha256 is None or args.archive_bytes is None
            or args.session_attempt is None or not args.source_pvc_uid or not args.source_pv_uid
            or not args.verification_pvc_uid or not args.verification_pv_uid):
            parser.error('session-action-shape')
        _session_rpc(args, readback=args.session_readback)
        return
    if args.load_inputs:
        if (args.phase is not None or not args.source_pvc_uid or not args.source_pv_uid
            or not args.verification_pvc_uid or not args.verification_pv_uid
            or not args.archive_sha256 or args.archive_bytes is None
            or args.session_attempt is None or not args.input_bundle_sha256
            or args.input_bundle_bytes is None):
            parser.error('load-inputs-shape')
        result = load_inputs(None, operation=args.operation, nonce=args.nonce,
            pod_uid=args.pod_uid, binding_args=args, input_stream=sys.stdin.buffer)
        _frame(result)
        return result
    if args.read_input_receipt:
        if (args.phase is not None or not args.source_pvc_uid or not args.source_pv_uid
            or not args.verification_pvc_uid or not args.verification_pv_uid
            or not args.archive_sha256 or args.archive_bytes is None
            or args.session_attempt is None or not args.input_bundle_sha256
            or args.input_bundle_bytes is None):
