def read_census_consumption_receipt(args):
    """Validate the loader receipt and same-attempt consumption receipt without mutation."""
    input_receipt = read_census_input_receipt(args)
    binding = _census_consumption_binding(args, input_receipt)
    state, _, _ = _census_input_action_paths(argparse.Namespace(
        operation=args.operation, session_attempt=args.session_attempt))
    marker_path = state / 'census-consumption.started.json'
    receipt_path = state / 'census-consumption.receipt.json'
    try:
        marker = _private_json(marker_path)
        receipt = _private_json(receipt_path)
    except (OSError, ValueError, json.JSONDecodeError):
        raise ValueError('verification_input_consumption_unknown') from None
    expected_marker = {'schema': 'voice-nats-census-consumption-action-v1',
        'phase': 'census-consumption', **binding, 'state': 'STARTED'}
    if marker != expected_marker:
        raise ValueError('verification_input_consumption_unknown')
    expected_receipt = {'schema': 'voice-nats-census-consumption-receipt-v1',
        'phase': 'census-consumption', **binding, 'status': 'COMPLETE'}
    if (not isinstance(receipt, dict) or set(receipt) != set(expected_receipt)
        or any(receipt.get(key) != value for key, value in expected_receipt.items())):
        raise ValueError('verification_input_consumption_unknown')
    return receipt


def consume_census_inputs(args):
    """Durably bind already-loaded census inputs to this exact execution Pod."""
    _require_verification_identity()
    _identity(args)
    if os.environ.get('POD_UID') != args.pod_uid:
        raise ValueError('verification_pod_identity')
    input_receipt = read_census_input_receipt(args)
    binding = _census_consumption_binding(args, input_receipt)
    state, _, _ = _census_input_action_paths(argparse.Namespace(
        operation=args.operation, session_attempt=args.session_attempt))
    marker_path = state / 'census-consumption.started.json'
    receipt_path = state / 'census-consumption.receipt.json'
    if marker_path.exists() or receipt_path.exists():
        if not marker_path.exists() or not receipt_path.exists():
            raise ValueError('verification_input_consumption_unknown')
        return read_census_consumption_receipt(args)
    marker = {'schema': 'voice-nats-census-consumption-action-v1',
        'phase': 'census-consumption', **binding, 'state': 'STARTED'}
    fd = os.open(marker_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'wb') as marker_stream:
        marker_stream.write(json.dumps(marker, sort_keys=True, separators=(',', ':')).encode())
        marker_stream.flush(); os.fsync(marker_stream.fileno())
    dirfd = os.open(state, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try: os.fsync(dirfd)
    finally: os.close(dirfd)
    receipt = {'schema': 'voice-nats-census-consumption-receipt-v1',
        'phase': 'census-consumption', **binding, 'status': 'COMPLETE'}
    fd = os.open(receipt_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'wb') as receipt_stream:
        receipt_stream.write(json.dumps(receipt, sort_keys=True, separators=(',', ':')).encode())
        receipt_stream.flush(); os.fsync(receipt_stream.fileno())
    dirfd = os.open(state, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try: os.fsync(dirfd)
    finally: os.close(dirfd)
    return receipt


def load_census_inputs(raw=None, *, operation, nonce, pod_uid, binding_args, input_stream=None):
    """Install only the trusted bootstrap credential and NATS config for PREPARE census."""
    _require_verification_identity()
    _identity(argparse.Namespace(operation=operation, nonce=nonce, pod_uid=pod_uid))
    if os.environ.get('POD_UID') != pod_uid:
        raise ValueError('verification_pod_identity')
    binding = _input_binding(binding_args)
    if (binding['operation'] != operation or binding['nonce'] != nonce
        or binding['pod_uid'] != pod_uid):
        raise ValueError('verification_input_binding')
    state, marker_path, receipt_path = _census_input_action_paths(binding_args)
    state_root = VERIFY_ROOT / 'state'
    operation_root = state_root / operation
    for directory in (state_root, operation_root):
        directory.mkdir(mode=0o700, exist_ok=True)
        row = directory.lstat()
        if (not stat.S_ISDIR(row.st_mode) or stat.S_ISLNK(row.st_mode)
            or row.st_uid != os.geteuid() or row.st_gid != os.getegid()
            or stat.S_IMODE(row.st_mode) != 0o700):
            raise ValueError('verification_inputs_custody')
    state.mkdir(mode=0o700, exist_ok=False)
    state_row = state.lstat()
    if (not stat.S_ISDIR(state_row.st_mode) or stat.S_ISLNK(state_row.st_mode)
        or state_row.st_uid != os.geteuid() or state_row.st_gid != os.getegid()
        or stat.S_IMODE(state_row.st_mode) != 0o700 or any(state.iterdir())):
        raise ValueError('verification_inputs_already_started')
    marker_value = {'schema': 'voice-nats-census-input-action-v1',
        'phase': 'census-inputs', **binding, 'state': 'STARTED'}
    fd = os.open(marker_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'wb') as marker_stream:
        marker_stream.write(json.dumps(marker_value, sort_keys=True, separators=(',', ':')).encode())
        marker_stream.flush(); os.fsync(marker_stream.fileno())
    for directory in (state, VERIFY_ROOT):
        dirfd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try: os.fsync(dirfd)
        finally: os.close(dirfd)
    if raw is None:
        if input_stream is None: input_stream = sys.stdin.buffer
        raw = input_stream.read(MAX_INPUT_BYTES + 1)
    if (not isinstance(raw, (bytes, bytearray)) or not 1 <= len(raw) <= MAX_INPUT_BYTES
        or len(raw) != binding['input_bundle_bytes']
        or hashlib.sha256(raw).hexdigest() != binding['input_bundle_sha256']):
        raise ValueError('verification_inputs')
    def pairs(items):
        value = {}
        for key, item in items:
            if key in value: raise ValueError('verification_inputs')
            value[key] = item
        return value
    try:
        bundle = json.loads(raw, object_pairs_hook=pairs,
            parse_constant=lambda _value: (_ for _ in ()).throw(ValueError('verification_inputs')))
    except (ValueError, TypeError, UnicodeError):
        raise ValueError('verification_inputs') from None
    if (not isinstance(bundle, dict) or set(bundle) != {'schema', 'operation', 'nonce', 'pod_uid', 'files'}
        or bundle.get('schema') != CENSUS_INPUT_SCHEMA
        or bundle.get('operation') != operation or bundle.get('nonce') != nonce
        or bundle.get('pod_uid') != pod_uid or not isinstance(bundle.get('files'), dict)
        or set(bundle['files']) != CENSUS_INPUT_FILES):
        raise ValueError('verification_inputs')
    INPUT_ROOT.mkdir(mode=0o700, parents=False, exist_ok=False)
    root = INPUT_ROOT.lstat()
    if (not stat.S_ISDIR(root.st_mode) or root.st_uid != os.geteuid()
        or stat.S_IMODE(root.st_mode) & 0o077):
        raise ValueError('verification_inputs')
    decoded = {}
    for name, encoded in bundle['files'].items():
        if not isinstance(encoded, str) or len(encoded) > 512 << 10:
            raise ValueError('verification_inputs')
        try:
            import base64
            data = base64.b64decode(encoded.encode('ascii'), validate=True)
        except (ValueError, UnicodeError):
            raise ValueError('verification_inputs') from None
        if not 1 <= len(data) <= 256 << 10:
            raise ValueError('verification_inputs')
        decoded[name] = data
    _server_config(decoded['server.conf'])
    for name in sorted(CENSUS_INPUT_FILES):
        _write_exclusive(INPUT_ROOT / name, decoded[name], mode=0o440)
    fd = os.open(INPUT_ROOT, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try: os.fsync(fd)
    finally: os.close(fd)
    kernel_bundle = VERIFY_ROOT / 'kernelinputbundle'
    public_root = VERIFY_ROOT / 'inputs' / 'public'
    kernel_bundle.mkdir(mode=0o700, exist_ok=False)
    (VERIFY_ROOT / 'inputs').mkdir(mode=0o700, exist_ok=True)
    public_root.mkdir(mode=0o700, exist_ok=False)
    _write_exclusive(kernel_bundle / 'bootstrap.creds', decoded['bootstrap.creds'], mode=0o440)
    _write_exclusive(public_root / 'server.conf', decoded['server.conf'], mode=0o440)
    kernel_hash = hashlib.sha256(json.dumps({'bootstrap.creds':
        hashlib.sha256(decoded['bootstrap.creds']).hexdigest()}, sort_keys=True,
        separators=(',', ':')).encode()).hexdigest()
    for directory in (kernel_bundle, public_root, public_root.parent, state,
        operation_root, state_root, VERIFY_ROOT):
        fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try: os.fsync(fd)
        finally: os.close(fd)
    receipt = {'schema': 'voice-nats-census-input-receipt-v1',
        'phase': 'census-inputs', **binding, 'status': 'COMPLETE',
        'file_count': len(decoded), 'kernel_bundle_sha256': kernel_hash,
        'server_config_sha256': hashlib.sha256(decoded['server.conf']).hexdigest()}
    fd = os.open(receipt_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'wb') as receipt_stream:
        receipt_stream.write(json.dumps(receipt, sort_keys=True, separators=(',', ':')).encode())
        receipt_stream.flush(); os.fsync(receipt_stream.fileno())
    dirfd = os.open(state, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try: os.fsync(dirfd)
    finally: os.close(dirfd)
    return receipt


def load_inputs(raw=None, *, operation, nonce, pod_uid, binding_args, input_stream=None):
    """Install the closed input bundle with a PVC-persisted, no-replay receipt."""
    _require_verification_identity()
    _identity(argparse.Namespace(operation=operation, nonce=nonce, pod_uid=pod_uid))
    if os.environ.get('POD_UID') != pod_uid:
        raise ValueError('verification_pod_identity')
    binding = _input_binding(binding_args)
    if (binding['operation'] != operation or binding['nonce'] != nonce
        or binding['pod_uid'] != pod_uid):
        raise ValueError('verification_input_binding')
    state, marker_path, receipt_path = _input_action_paths(binding_args)
    state_root = VERIFY_ROOT / 'state'
    operation_root = state_root / operation
    for directory in (state_root, operation_root):
        directory.mkdir(mode=0o700, exist_ok=True)
        row = directory.lstat()
        if (not stat.S_ISDIR(row.st_mode) or stat.S_ISLNK(row.st_mode)
            or row.st_uid != os.geteuid() or row.st_gid != os.getegid()
            or stat.S_IMODE(row.st_mode) != 0o700):
            raise ValueError('verification_inputs_custody')
    state.mkdir(mode=0o700, exist_ok=False)
    state_row = state.lstat()
    if (not stat.S_ISDIR(state_row.st_mode) or stat.S_ISLNK(state_row.st_mode)
        or state_row.st_uid != os.geteuid() or stat.S_IMODE(state_row.st_mode) != 0o700
        or any(state.iterdir())):
        raise ValueError('verification_inputs_already_started')
    marker_value = {'schema': 'voice-nats-input-action-v1', 'phase': 'inputs',
        **binding, 'state': 'STARTED'}
    fd = os.open(marker_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'wb') as marker_stream:
        marker_stream.write(json.dumps(marker_value, sort_keys=True, separators=(',', ':')).encode())
        marker_stream.flush(); os.fsync(marker_stream.fileno())
    for directory in (state, VERIFY_ROOT):
        dirfd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try: os.fsync(dirfd)
        finally: os.close(dirfd)
    if raw is None:
        if input_stream is None: input_stream = sys.stdin.buffer
        raw = input_stream.read(MAX_INPUT_BYTES + 1)
    if (not isinstance(raw, (bytes, bytearray)) or not 1 <= len(raw) <= MAX_INPUT_BYTES
        or len(raw) != binding['input_bundle_bytes']
        or hashlib.sha256(raw).hexdigest() != binding['input_bundle_sha256']):
        raise ValueError('verification_inputs')
    def pairs(items):
        value = {}
        for key, item in items:
            if key in value: raise ValueError('verification_inputs')
            value[key] = item
        return value
    try:
        bundle = json.loads(raw, object_pairs_hook=pairs)
    except (ValueError, TypeError, UnicodeError):
        raise ValueError('verification_inputs') from None
    if (not isinstance(bundle, dict) or set(bundle) != {'schema', 'operation', 'nonce', 'pod_uid', 'files'}
        or bundle.get('schema') != 'voice-nats-verification-inputs-v1'
        or bundle.get('operation') != operation or bundle.get('nonce') != nonce
        or bundle.get('pod_uid') != pod_uid or not isinstance(bundle.get('files'), dict)
        or set(bundle['files']) != INPUT_FILES):
        raise ValueError('verification_inputs')
    INPUT_ROOT.mkdir(mode=0o700, parents=False, exist_ok=False)
    root = INPUT_ROOT.lstat()
    if (not stat.S_ISDIR(root.st_mode) or root.st_uid != os.geteuid()
        or stat.S_IMODE(root.st_mode) & 0o077):
        raise ValueError('verification_inputs')
    decoded = {}
    for name, encoded in bundle['files'].items():
        if not isinstance(encoded, str) or len(encoded) > 512 << 10:
            raise ValueError('verification_inputs')
        try:
            import base64
            data = base64.b64decode(encoded.encode('ascii'), validate=True)
        except (ValueError, UnicodeError):
            raise ValueError('verification_inputs') from None
        if not 1 <= len(data) <= 256 << 10:
            raise ValueError('verification_inputs')
        decoded[name] = data
    _server_config(decoded['server.conf'])
    for name in sorted(INPUT_FILES):
        path = INPUT_ROOT / name
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o440)
        with os.fdopen(fd, 'wb') as stream:
            stream.write(decoded[name]); stream.flush(); os.fsync(stream.fileno())
    fd = os.open(INPUT_ROOT, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try: os.fsync(fd)
    finally: os.close(fd)
    # The census Pod's emptyDir is temporary. Persist a disjoint fixed bundle
    # and broker-only config projection on this operation's nonpromotable PVC
    # before reporting the input action COMPLETE.
    session_root = state
    kernel_bundle = VERIFY_ROOT / 'kernelinputbundle'
    public_root = VERIFY_ROOT / 'inputs' / 'public'
    kernel_bundle.mkdir(mode=0o700, exist_ok=False)
    (VERIFY_ROOT / 'inputs').mkdir(mode=0o700, exist_ok=True)
    public_root.mkdir(mode=0o700, exist_ok=False)
    for name in sorted(SESSION_INPUT_FILES):
        _write_exclusive(kernel_bundle / name, decoded[name], mode=0o440)
    _write_exclusive(public_root / 'server.conf', decoded['server.conf'], mode=0o440)
    kernel_bundle_hash = hashlib.sha256(json.dumps({name: hashlib.sha256(decoded[name]).hexdigest()
        for name in sorted(SESSION_INPUT_FILES)}, sort_keys=True, separators=(',', ':')).encode()).hexdigest()
    for directory in (kernel_bundle, public_root, public_root.parent, session_root,
        operation_root, state_root, VERIFY_ROOT):
        fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try: os.fsync(fd)
        finally: os.close(fd)
    receipt = {'schema': 'voice-nats-input-receipt-v1', 'phase': 'inputs',
        **binding, 'status': 'COMPLETE', 'file_count': len(decoded),
        'kernel_bundle_sha256': kernel_bundle_hash,
        'server_config_sha256': hashlib.sha256(decoded['server.conf']).hexdigest()}
    fd = os.open(receipt_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'wb') as receipt_stream:
        receipt_stream.write(json.dumps(receipt, sort_keys=True, separators=(',', ':')).encode())
        receipt_stream.flush(); os.fsync(receipt_stream.fileno())
    dirfd = os.open(state, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try: os.fsync(dirfd)
    finally: os.close(dirfd)
    return receipt


def _verify_session_input_projection(receipt):
    owned_dirs = (
        VERIFY_ROOT / 'state', VERIFY_ROOT / 'state' / receipt['operation'],
        VERIFY_ROOT / 'state' / receipt['operation'] / receipt['session_attempt'],
        VERIFY_ROOT / 'kernelinputbundle', VERIFY_ROOT / 'inputs', VERIFY_ROOT / 'inputs' / 'public')
    for directory in owned_dirs:
        row = directory.lstat()
        if (not stat.S_ISDIR(row.st_mode) or stat.S_ISLNK(row.st_mode)
            or row.st_uid != os.geteuid() or row.st_gid != os.getegid()
            or stat.S_IMODE(row.st_mode) != 0o700):
            raise ValueError('verification_inputs_incomplete')
    bundle = VERIFY_ROOT / 'kernelinputbundle'
    public = VERIFY_ROOT / 'inputs' / 'public'
    if (set(path.name for path in bundle.iterdir()) != SESSION_INPUT_FILES
        or set(path.name for path in public.iterdir()) != {'server.conf'}):
        raise ValueError('verification_inputs_incomplete')
    digests = {}
    for name in sorted(SESSION_INPUT_FILES):
        raw = _read_session_file(bundle / name, max_bytes=256 << 10,
            uid=os.geteuid(), gid=os.getegid(), mode=0o440, code='verification_inputs_incomplete')
        digests[name] = hashlib.sha256(raw).hexdigest()
    config = _read_session_file(public / 'server.conf', max_bytes=256 << 10,
        uid=os.geteuid(), gid=os.getegid(), mode=0o440, code='verification_inputs_incomplete')
    bundle_hash = hashlib.sha256(json.dumps(digests, sort_keys=True,
        separators=(',', ':')).encode()).hexdigest()
    if (bundle_hash != receipt.get('kernel_bundle_sha256')
        or hashlib.sha256(config).hexdigest() != receipt.get('server_config_sha256')):
        raise ValueError('verification_inputs_incomplete')


def _private_inputs():
    rows = {}
    if not INPUT_ROOT.is_dir() or INPUT_ROOT.is_symlink():
        raise ValueError('verification_inputs')
    entries = sorted(path.name for path in INPUT_ROOT.iterdir())
    if set(entries) != INPUT_FILES:
        raise ValueError('verification_inputs')
    for name in entries:
        path = INPUT_ROOT / name
        row = path.lstat()
        if (not stat.S_ISREG(row.st_mode) or row.st_uid != os.geteuid() or row.st_nlink != 1
            or stat.S_IMODE(row.st_mode) != 0o440 or row.st_size > 256 << 10):
            raise ValueError('verification_inputs')
        data = path.read_bytes()
        if len(data) != row.st_size:
            raise ValueError('verification_inputs')
        rows[name] = data
    rows['server.conf'] = _server_config(rows['server.conf'])
    return rows


