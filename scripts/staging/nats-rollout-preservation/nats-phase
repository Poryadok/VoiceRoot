    if args.load_census_inputs:
        if (args.phase is not None or not args.source_pvc_uid or not args.source_pv_uid
            or not args.verification_pvc_uid or not args.verification_pv_uid
            or not args.archive_sha256 or args.archive_bytes is None
            or args.session_attempt is None or not args.input_bundle_sha256
            or args.input_bundle_bytes is None or args.input_pod_uid is not None):
            parser.error('load-census-inputs-shape')
        result = load_census_inputs(None, operation=args.operation, nonce=args.nonce,
            pod_uid=args.pod_uid, binding_args=args, input_stream=sys.stdin.buffer)
        _frame(result)
        return result
    if args.read_census_input_receipt:
        if (args.phase is not None or not args.source_pvc_uid or not args.source_pv_uid
            or not args.verification_pvc_uid or not args.verification_pv_uid
            or not args.archive_sha256 or args.archive_bytes is None
            or args.session_attempt is None or not args.input_bundle_sha256
            or args.input_bundle_bytes is None or not args.input_pod_uid):
            parser.error('read-census-input-receipt-shape')
        result = read_census_input_receipt(args)
        _frame(result)
        return result
    if args.consume_census_inputs:
        if (args.phase is not None or not args.source_pvc_uid or not args.source_pv_uid
            or not args.verification_pvc_uid or not args.verification_pv_uid
            or not args.archive_sha256 or args.archive_bytes is None
            or args.session_attempt is None or not args.input_bundle_sha256
            or args.input_bundle_bytes is None or not args.input_pod_uid):
            parser.error('consume-census-inputs-shape')
        result = consume_census_inputs(args)
        _frame(result)
        return result
    if args.read_receipt:
        if (args.phase is None or not args.source_pvc_uid or not args.source_pv_uid
            or not args.verification_pvc_uid or not args.verification_pv_uid
            or not args.archive_sha256 or args.archive_bytes is None
            or args.input_pod_uid is None or args.session_attempt is None
            or args.input_bundle_sha256 is None or args.input_bundle_bytes is None):
            parser.error('verification-volume-identity-required')
        receipt = read_verification_receipt(args.phase, args)
        stream_census_readback(receipt)
        return receipt
    if args.receive_archive:
        if (not args.source_pvc_uid or not args.source_pv_uid
            or not args.verification_pvc_uid or not args.verification_pv_uid
            or not args.archive_sha256 or args.archive_bytes is None or args.phase is not None
            or args.input_pod_uid is None or args.session_attempt is None
            or args.input_bundle_sha256 is None or args.input_bundle_bytes is None):
            parser.error('verification-volume-identity-required')
        receipt = run_verification('census', args)
        return receipt
    (create_and_stream if args.create_and_stream else stream_existing)(args)


