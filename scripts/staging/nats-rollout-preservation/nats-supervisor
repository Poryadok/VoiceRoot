#!/usr/bin/python3
"""Fixed loopback supervisor for the isolated verification NATS child."""
import json
import hashlib
import os
import signal
import socket
import stat
import subprocess
import sys
import time


PORT = 9444
SERVER = '/usr/local/bin/nats-server'
CONFIG = '/broker-config/server.conf'
SCHEMA = 'voice-nats-supervisor-v1'
MAX_LINE = 256


class BrokerSupervisor:
    def __init__(self, popen=subprocess.Popen, *, contract=False, preflight=False,
            server=SERVER):
        self._popen = popen
        self.contract = contract or preflight
        self.preflight = preflight
        self.server = server
        self.child = None
        self.started_at_ns = None
        self.stopping = False
        self.binary_sha256 = self._binary_digest() if preflight else None

    def _binary_digest(self):
        fd = os.open(self.server, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        try:
            before = os.fstat(fd)
            if not stat.S_ISREG(before.st_mode) or not before.st_mode & 0o111:
                raise ValueError('server_binary')
            digest = hashlib.sha256()
            while True:
                chunk = os.read(fd, 1 << 20)
                if not chunk:
                    break
                digest.update(chunk)
            after = os.fstat(fd)
            if (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns, before.st_ctime_ns) != (
                after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns, after.st_ctime_ns):
                raise ValueError('server_binary_changed')
            return digest.hexdigest()
        finally:
            os.close(fd)

    def _metadata(self, result):
        if self.preflight:
            result['nats_binary_sha256'] = self.binary_sha256
        return result

    def handle(self, action):
        if action == 'start':
            if self.child is not None and self.child.poll() is None:
                raise ValueError('already_running')
            self.child = self._popen([self.server, '--config', CONFIG], stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, close_fds=True)
            self.started_at_ns = time.time_ns()
            result = {'running': True}
            if self.contract:
                result.update(pid=self.child.pid, started_at_ns=self.started_at_ns)
            return self._metadata(result)
        if action == 'stop':
            pid = self.child.pid if self.child is not None else None
            started = self.started_at_ns
            exit_code = self.child.poll() if self.child is not None else None
            if self.child is not None and exit_code is None:
                self.child.terminate()
                try:
                    exit_code = self.child.wait(timeout=30)
                except subprocess.TimeoutExpired:
                    raise ValueError('stop_incomplete') from None
            elif self.child is not None:
                exit_code = self.child.poll()
            self.child = None
            self.started_at_ns = None
            result = {'running': False}
            if self.contract:
                result.update(pid=pid, started_at_ns=started, finished_at_ns=time.time_ns(),
                    exit_code=exit_code)
            return self._metadata(result)
        if action == 'status':
            running = self.child is not None and self.child.poll() is None
            result = {'running': running}
            if self.contract:
                result.update(pid=self.child.pid if running else None,
                    started_at_ns=self.started_at_ns if running else None)
                if not running and self.preflight:
                    result.update(exit_code=None, finished_at_ns=None)
            return self._metadata(result)
        if action == 'shutdown':
            if self.child is not None and self.child.poll() is None:
                raise ValueError('shutdown_while_running')
            self.stopping = True
            return {'running': False, 'stopping': True}
        raise ValueError('action_invalid')


def _response(supervisor, line):
    try:
        value = json.loads(line)
        if (not isinstance(value, dict) or set(value) != {'schema', 'action'}
            or value['schema'] != SCHEMA
            or value['action'] not in ('start', 'stop', 'status', 'shutdown')):
            raise ValueError('request_invalid')
        return {'schema': SCHEMA, 'ok': True, **supervisor.handle(value['action'])}
    except (ValueError, TypeError, KeyError, json.JSONDecodeError):
        return {'schema': SCHEMA, 'ok': False}


def serve(*, host='127.0.0.1', port=PORT, supervisor=None, server_factory=socket.socket,
        contract=False, preflight=False):
    if host != '127.0.0.1' or port != PORT:
        raise ValueError('listener_invalid')
    supervisor = supervisor or BrokerSupervisor(contract=contract, preflight=preflight)
    listener = server_factory(socket.AF_INET, socket.SOCK_STREAM)
    listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    listener.bind((host, port))
    listener.listen(4)
    listener.settimeout(1.0)
    try:
        while not supervisor.stopping:
            try:
                conn, _ = listener.accept()
            except socket.timeout:
                if supervisor.child is not None and supervisor.child.poll() is not None:
                    supervisor.child = None
                continue
            with conn:
                conn.settimeout(5)
                line = bytearray()
                while len(line) <= MAX_LINE and b'\n' not in line:
                    part = conn.recv(MAX_LINE + 1 - len(line))
                    if not part:
                        break
                    line.extend(part)
                raw, separator, trailing = bytes(line).partition(b'\n')
                if not separator or trailing or len(raw) > MAX_LINE:
                    result = {'schema': SCHEMA, 'ok': False}
                else:
                    result = _response(supervisor, raw)
                conn.sendall(json.dumps(result, sort_keys=True, separators=(',', ':')).encode() + b'\n')
    finally:
        listener.close()
        if supervisor.child is not None and supervisor.child.poll() is None:
            supervisor.handle('stop')


if __name__ == '__main__':
    try:
        contract = sys.argv[1:] == ['--contract']
        preflight = sys.argv[1:] == ['--preflight']
        if sys.argv[1:] not in ([], ['--contract'], ['--preflight']):
            raise ValueError('argv')
        expected_uid = 10000 if contract else 65532
        if os.geteuid() != expected_uid or os.getegid() != expected_uid:
            raise ValueError('identity')
        serve(contract=contract, preflight=preflight)
    except Exception:
        # This channel never logs NATS configuration or process output.
        raise SystemExit(1)
