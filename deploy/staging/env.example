# Shell env for local or manual staging apply (do not commit real secrets).
# See docs/DEPLOYMENT.md § VOICE_IMAGE_TAG (required) and deploy/staging/README.md.

export VOICE_IMAGE_REGISTRY=ghcr.io/your-org/voiceroot
export VOICE_IMAGE_TAG=<git-sha>   # required — same SHA as GHCR after green CI; no :latest

# Optional
# export VOICE_K8S_NAMESPACE=voice-staging
# export DEPLOY_MODE=full          # full | app-only | images-only
# export VOICE_IMAGE_PULL_SECRET=ghcr-pull
# export STAGING_KUBECONFIG=~/.kube/config
# export VOICE_APPLY_OBSERVABILITY=true
