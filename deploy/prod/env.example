# Shell env for local or manual production apply (do not commit real secrets).
# See docs/DEPLOYMENT.md § VOICE_IMAGE_TAG (required) and deploy/prod/README.md.

export VOICE_IMAGE_REGISTRY=ghcr.io/your-org/voiceroot
export VOICE_IMAGE_TAG=<git-sha>   # required — git SHA or semver; no :latest default

# Optional
# export VOICE_K8S_NAMESPACE=voice-prod
# export DEPLOY_MODE=full          # full | app-only | images-only
# export VOICE_PROD_IMAGE_PULL_SECRET=ghcr-pull
# export VOICE_PROD_APPLY_OBSERVABILITY=true
